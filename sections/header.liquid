{%- liquid
  assign logo = section.settings.logo
  assign menu = section.settings.menu
-%}

<header class="site-header" data-header>
  <div class="site-header__bar">
    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 400
          | image_tag:
            widths: '160, 240, 320, 400',
            sizes: '156px',
            alt: shop.name,
            class: 'site-header__logo-image'
        }}
      {%- else -%}
        <img
          class="site-header__logo-image"
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="156"
          height="27"
        >
      {%- endif -%}
    </a>

    <nav class="site-header__nav" id="SiteNav-{{ section.id }}" aria-label="{{ 'header.navigation' | t }}">
      <ul class="site-header__menu">
        {%- if menu != blank and menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            <li>
              <a
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: routes.root_url }}">
                {{ block.settings.label | escape }}
              </a>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
        <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
          <path d="M7 8h14l-1.2 12.2a2 2 0 0 1-2 1.8H10.2a2 2 0 0 1-2-1.8L7 8Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <path d="M10.5 8V6.8A3.5 3.5 0 0 1 14 3.3a3.5 3.5 0 0 1 3.5 3.5V8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="site-header__count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

      <button
        class="site-header__toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="SiteNav-{{ section.id }}"
      >
        <span class="site-header__toggle-lines" aria-hidden="true"></span>
        <span class="visually-hidden">{{ 'header.menu' | t }}</span>
      </button>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: relative;
    z-index: 20;
    background: #ffffff;
    color: #111111;
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 86px;
    width: min(1440px, 100%);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 8vw, 7.125rem);
  }

  .site-header__logo {
    justify-self: start;
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo-image {
    width: auto;
    height: 27px;
    max-width: 160px;
  }

  .site-header__nav {
    justify-self: center;
  }

  .site-header__menu {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__menu a {
    color: #111111;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: none;
  }

  .site-header__menu a[aria-current='page'] {
    font-weight: 600;
  }

  .site-header__menu a:hover,
  .site-header__menu a:focus-visible {
    color: #2d42a9;
  }

  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__cart {
    position: relative;
    display: flex;
    color: #121a43;
    text-decoration: none;
  }

  .site-header__cart svg {
    width: 28px;
    height: 28px;
  }

  .site-header__count {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: #121a43;
    color: #ffffff;
    font-size: 10px;
    line-height: 16px;
    text-align: center;
  }

  .site-header__toggle {
    display: none;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .site-header__toggle-lines,
  .site-header__toggle-lines::before,
  .site-header__toggle-lines::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: #121a43;
    content: '';
  }

  .site-header__toggle-lines {
    position: relative;
    margin-inline: auto;
  }

  .site-header__toggle-lines::before,
  .site-header__toggle-lines::after {
    position: absolute;
    left: 0;
  }

  .site-header__toggle-lines::before {
    top: -6px;
  }

  .site-header__toggle-lines::after {
    top: 6px;
  }

  .site-header.is-open .site-header__toggle-lines {
    background: transparent;
  }

  .site-header.is-open .site-header__toggle-lines::before {
    top: 0;
    transform: rotate(45deg);
  }

  .site-header.is-open .site-header__toggle-lines::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 989px) {
    .site-header__bar {
      grid-template-columns: auto 1fr auto;
      min-height: 72px;
    }

    .site-header__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .site-header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      justify-self: stretch;
      width: 100%;
      background: #ffffff;
      border-top: 1px solid #ececec;
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.06);
    }

    .site-header.is-open .site-header__nav {
      display: block;
    }

    .site-header__menu {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 0 0.75rem;
    }

    .site-header__menu a {
      display: block;
      padding: 0.9rem 1.25rem;
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% javascript %}
document.addEventListener('click', (event) => {
  const toggle = event.target.closest('[data-menu-toggle]');
  if (!toggle) return;
  const header = toggle.closest('[data-header]');
  if (!header) return;
  const open = header.classList.toggle('is-open');
  toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
});
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:sections.header.settings.menu_info"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "t:sections.header.blocks.link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.header.blocks.link.label",
          "default": "Home"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.header.blocks.link.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.header.name"
    }
  ]
}
{% endschema %}

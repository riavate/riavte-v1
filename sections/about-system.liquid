<section class="about-system">
  <div class="about-system__inner">
    <div class="about-system__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about-system__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-system__heading">{{ section.settings.heading | escape | replace: '. ', '.<br>' }}</h2>
      {%- endif -%}
    </div>
    <ol class="about-system__list">
      {%- for block in section.blocks -%}
        <li class="about-system__row" {{ block.shopify_attributes }}>
          <p class="about-system__index">0{{ forloop.index }}</p>
          <div class="about-system__copy">
            {%- if block.settings.kicker != blank -%}
              <p class="about-system__kicker">{{ block.settings.kicker | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="about-system__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="about-system__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
          <div class="about-system__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '480, 800, 1200',
                  sizes: '(min-width: 990px) 46vw, 100vw',
                  alt: block.settings.image_alt,
                  class: 'about-system__image',
                  loading: 'lazy'
              }}
            {%- else -%}
              {%- if block.settings.fallback == 'serum' -%}
                <img class="about-system__image" src="{{ 'about-serum.jpg' | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1024" height="556" loading="lazy">
              {%- elsif block.settings.fallback == 'kit' -%}
                <img class="about-system__image" src="{{ 'about-kit.jpg' | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1024" height="556" loading="lazy">
              {%- else -%}
                <img class="about-system__image" src="{{ 'about-needles.jpg' | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1024" height="556" loading="lazy">
              {%- endif -%}
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .about-system {
    color: #1a2744;
    background: linear-gradient(#e7f0ff, #e7f0ff) left / 8px 100% no-repeat #ffffff;
  }

  .about-system__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 5.5rem 1.5rem 5rem 2.75rem;
  }

  .about-system__intro {
    margin-bottom: 4.5rem;
  }

  .about-system__heading {
    max-width: 22ch;
  }

  .about-system__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8b93a7;
  }

  .about-system__heading {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 2.85rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .about-system__list {
    display: grid;
    gap: 4.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-system__row {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr) minmax(220px, 38%);
    gap: 1.25rem 2.25rem;
    align-items: center;
  }

  .about-system__index {
    margin: 0;
    font-size: clamp(1.7rem, 2.2vw, 2.15rem);
    font-weight: 500;
    line-height: 1;
    color: #c5cedb;
  }

  .about-system__kicker {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8b93a7;
  }

  .about-system__title {
    margin: 0;
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .about-system__text {
    max-width: 34rem;
    margin-top: 0.7rem;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.65;
    color: #5c6578;
  }

  .about-system__text p {
    margin: 0;
  }

  .about-system__media {
    border-radius: 1.15rem;
    overflow: hidden;
  }

  .about-system__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .about-system__inner {
      padding: 3.5rem 1.25rem 3.5rem 1.5rem;
    }

    .about-system__row {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.75rem 1rem;
    }

    .about-system__media {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_system.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.about_system.settings.eyebrow",
      "default": "What makes Riavâte different"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about_system.settings.heading",
      "default": "One system. Designed with purpose."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.about_system.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.about_system.blocks.row.kicker",
          "default": "01 — The device"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.about_system.blocks.row.title",
          "default": "0.5 mm precision"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.about_system.blocks.row.text",
          "default": "<p>The 0.5 mm micro-infusion applicator, engineered for controlled application.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.about_system.blocks.row.image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:sections.about_system.blocks.row.image_alt",
          "default": "Riavâte system detail"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "t:sections.about_system.blocks.row.fallback",
          "options": [
            { "value": "needles", "label": "t:sections.about_system.options.needles" },
            { "value": "serum", "label": "t:sections.about_system.options.serum" },
            { "value": "kit", "label": "t:sections.about_system.options.kit" }
          ],
          "default": "needles"
        },
        {
          "type": "select",
          "id": "image_side",
          "label": "t:sections.about_system.blocks.row.image_side",
          "options": [
            { "value": "right", "label": "t:sections.about_system.options.right" },
            { "value": "left", "label": "t:sections.about_system.options.left" }
          ],
          "default": "right"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:sections.about_system.name",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "kicker": "01 — The device",
            "title": "0.5 mm precision",
            "text": "<p>A controlled 0.5 mm micro-infusion system designed for precise, targeted scalp application.</p>",
            "image_alt": "Gold-plated micro-infusion tips",
            "fallback": "needles",
            "image_side": "right"
          }
        },
        {
          "type": "row",
          "settings": {
            "kicker": "02 — The formula",
            "title": "Cuprofuse® concentrate",
            "text": "<p>Our concentrated serum, led by GHK-Cu and formulated with a precisely configured combination of selected scalp-care ingredients.</p>",
            "image_alt": "Cuprofuse serum being measured into a vial",
            "fallback": "serum",
            "image_side": "left"
          }
        },
        {
          "type": "row",
          "settings": {
            "kicker": "03 — The system",
            "title": "Designed together",
            "text": "<p>Device and formula, brought together as one considered scalp-care system.</p>",
            "image_alt": "Riavâte device and serum vial",
            "fallback": "kit",
            "image_side": "right"
          }
        }
      ]
    }
  ]
}
{% endschema %}

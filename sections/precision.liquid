<section class="precision">
  <div class="precision__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="precision__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="precision__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="precision__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>

  <div class="precision__stage">
    <img
      class="precision__line precision__line--top-left"
      src="{{ 'precision-line-top-left.png' | asset_url }}"
      alt=""
      width="1024"
      height="200"
      loading="lazy"
    >
    <img
      class="precision__line precision__line--top-right"
      src="{{ 'precision-line-top-right.png' | asset_url }}"
      alt=""
      width="1024"
      height="200"
      loading="lazy"
    >
    <img
      class="precision__line precision__line--bottom-left"
      src="{{ 'precision-line-bottom-left.png' | asset_url }}"
      alt=""
      width="651"
      height="232"
      loading="lazy"
    >
    <img
      class="precision__line precision__line--bottom-right"
      src="{{ 'precision-line-bottom-right.png' | asset_url }}"
      alt=""
      width="652"
      height="232"
      loading="lazy"
    >

    <div class="precision__media">
      <img
        class="precision__image"
        src="{{ 'precision-bottle.jpg' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="723"
        height="1024"
        loading="lazy"
      >
    </div>

    {%- for block in section.blocks -%}
      <article class="precision__point precision__point--{{ block.settings.position }}" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .precision {
    padding: 4.75rem 0 4.5rem;
    background: #000000;
    color: #ffffff;
  }

  .precision__intro {
    width: min(780px, calc(100% - 2.5rem));
    margin: 0 auto 0.5rem;
    text-align: center;
  }

  .precision__heading {
    margin: 0;
    color: #ffffff;
    font-family: Montserrat, sans-serif;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .precision__eyebrow {
    margin: 0.65rem 0 0;
    color: #ffffff;
    font-family: Montserrat, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.38em;
    text-transform: uppercase;
  }

  .precision__text {
    margin: 0.85rem auto 0;
    max-width: 46rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .precision__stage {
    position: relative;
    width: min(1120px, calc(100% - 1.5rem));
    aspect-ratio: 1120 / 640;
    margin: 0.75rem auto 0;
  }

  .precision__media {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    width: 34%;
    transform: translateX(-50%);
  }

  .precision__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .precision__line {
    position: absolute;
    z-index: 0;
    display: block;
    pointer-events: none;
    object-fit: fill;
  }

  .precision__line--top-left {
    top: 18%;
    right: 52%;
    width: 28%;
    height: 18%;
  }

  .precision__line--top-right {
    top: 18%;
    left: 52%;
    width: 28%;
    height: 18%;
  }

  .precision__line--bottom-left {
    top: 48%;
    right: 52%;
    width: 28%;
    height: 22%;
  }

  .precision__line--bottom-right {
    top: 48%;
    left: 52%;
    width: 28%;
    height: 22%;
  }

  .precision__point h3 {
    margin: 0;
    color: #ffffff;
    font-family: Montserrat, sans-serif;
    font-size: clamp(11px, 1.15vw, 13px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .precision__point p {
    margin: 0.4rem 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-family: Montserrat, sans-serif;
    font-size: clamp(12px, 1.2vw, 14px);
    font-weight: 500;
    line-height: 1.4;
  }

  .precision__point--top-left,
  .precision__point--top-right,
  .precision__point--bottom-left,
  .precision__point--bottom-right {
    position: absolute;
    z-index: 2;
    width: 20%;
  }

  .precision__point--top-left {
    top: 4%;
    left: 2%;
    text-align: right;
  }

  .precision__point--top-right {
    top: 4%;
    right: 2%;
    text-align: left;
  }

  .precision__point--bottom-left {
    top: 72%;
    left: 2%;
    text-align: left;
  }

  .precision__point--bottom-right {
    top: 72%;
    right: 2%;
    text-align: right;
  }

  .precision__point--top-left p {
    margin-left: auto;
  }

  .precision__point--bottom-right p {
    margin-left: auto;
  }

  @media screen and (max-width: 989px) {
    .precision__stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(120px, 180px) minmax(0, 1fr);
      grid-template-areas:
        "top-left . top-right"
        "line-left media line-right"
        "bottom-left . bottom-right";
      align-items: center;
      width: min(720px, calc(100% - 1.5rem));
      aspect-ratio: auto;
      height: auto;
      column-gap: 0.35rem;
      row-gap: 0.85rem;
    }

    .precision__media,
    .precision__point,
    .precision__line,
    .precision__point--top-left,
    .precision__point--top-right,
    .precision__point--bottom-left,
    .precision__point--bottom-right {
      position: static;
      top: auto;
      right: auto;
      left: auto;
      width: auto;
      height: auto;
      transform: none;
    }

    .precision__media {
      grid-area: media;
      width: 100%;
    }

    .precision__line--top-left,
    .precision__line--bottom-left {
      grid-area: line-left;
      width: 100%;
      max-width: 140px;
      justify-self: end;
    }

    .precision__line--top-right,
    .precision__line--bottom-right {
      grid-area: line-right;
      width: 100%;
      max-width: 140px;
      justify-self: start;
    }

    .precision__line--bottom-left,
    .precision__line--bottom-right {
      display: none;
    }

    .precision__point--top-left { grid-area: top-left; text-align: left; }
    .precision__point--top-right { grid-area: top-right; text-align: right; }
    .precision__point--bottom-left { grid-area: bottom-left; }
    .precision__point--bottom-right { grid-area: bottom-right; text-align: right; }

    .precision__point--top-left p,
    .precision__point--bottom-right p {
      margin-left: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .precision {
      padding: 3rem 0 2.75rem;
    }

    .precision__stage {
      grid-template-columns: minmax(0, 1fr) minmax(96px, 140px) minmax(0, 1fr);
    }

    .precision__point h3 {
      font-size: 11px;
    }

    .precision__point p {
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.precision.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.precision.settings.heading",
      "default": "0.5 mm precision"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.precision.settings.eyebrow",
      "default": "Micro-infusion"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.precision.settings.text",
      "default": "Engineered for controlled, targeted scalp application, Riavâte’s 0.5 mm micro-infusion system uses precision micro-touchpoints to apply the cosmetic formula consistently across the scalp."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.precision.settings.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.precision.settings.image_alt",
      "default": "Riavâte 0.5 mm micro-infusion device"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.precision.blocks.point.name",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "t:sections.precision.blocks.point.position",
          "options": [
            { "value": "top-left", "label": "t:sections.precision.options.top_left" },
            { "value": "top-right", "label": "t:sections.precision.options.top_right" },
            { "value": "bottom-left", "label": "t:sections.precision.options.bottom_left" },
            { "value": "bottom-right", "label": "t:sections.precision.options.bottom_right" }
          ],
          "default": "top-left"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.precision.blocks.point.title",
          "default": "Even distribution"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.precision.blocks.point.text",
          "default": "Helps distribute the cosmetic serum consistently across the treatment area."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "t:sections.precision.name" }
  ]
}
{% endschema %}

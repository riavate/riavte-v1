<section class="precision">
  <div class="precision__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="precision__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="precision__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="precision__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>

  <div class="precision__stage">
    <div class="precision__diagram">
      <img
        class="precision__image"
        src="{{ 'precision-device-lines.jpg' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="1024"
        height="607"
        loading="lazy"
      >
    </div>

    {%- for block in section.blocks -%}
      <article class="precision__point precision__point--{{ block.settings.position }}" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .precision {
    padding: 4.75rem 0 4.5rem;
    background: #000000;
    color: #ffffff;
  }

  .precision__intro {
    width: min(780px, calc(100% - 2.5rem));
    margin: 0 auto 1.25rem;
    text-align: center;
  }

  .precision__heading {
    margin: 0;
    color: #ffffff;
    font-family: Montserrat, sans-serif;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .precision__eyebrow {
    margin: 0.65rem 0 0;
    color: #ffffff;
    font-family: Montserrat, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.38em;
    text-transform: uppercase;
  }

  .precision__text {
    margin: 0.85rem auto 0;
    max-width: 46rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .precision__stage {
    position: relative;
    width: min(1100px, calc(100% - 1.5rem));
    margin: 0 auto;
  }

  .precision__diagram {
    width: 100%;
  }

  .precision__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .precision__point h3 {
    margin: 0;
    color: #ffffff;
    font-family: Montserrat, sans-serif;
    font-size: clamp(11px, 1.15vw, 13px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .precision__point p {
    margin: 0.4rem 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-family: Montserrat, sans-serif;
    font-size: clamp(12px, 1.2vw, 14px);
    font-weight: 500;
    line-height: 1.4;
  }

  .precision__point--top-left,
  .precision__point--top-right,
  .precision__point--bottom-left,
  .precision__point--bottom-right {
    position: absolute;
    z-index: 2;
    width: 22%;
  }

  /* Anchored to L-line tips in precision-device-lines.jpg (1024x607) */
  .precision__point--top-left {
    top: 3.5%;
    left: 1.5%;
    width: 26%;
    text-align: right;
  }

  .precision__point--top-right {
    top: 3.5%;
    right: 1.5%;
    width: 26%;
    text-align: left;
  }

  .precision__point--bottom-left {
    top: 71.5%;
    left: 2%;
    width: 26%;
    text-align: left;
  }

  .precision__point--bottom-right {
    top: 71.5%;
    right: 2%;
    width: 26%;
    text-align: right;
  }

  .precision__point--top-left p,
  .precision__point--bottom-right p {
    margin-left: auto;
  }

  @media screen and (max-width: 989px) {
    .precision__stage {
      display: grid;
      grid-template-columns: 1fr;
      width: min(640px, calc(100% - 1.5rem));
      row-gap: 1rem;
    }

    .precision__diagram {
      grid-row: 1;
      width: 100%;
    }

    .precision__point--top-left,
    .precision__point--top-right,
    .precision__point--bottom-left,
    .precision__point--bottom-right {
      position: static;
      top: auto;
      right: auto;
      left: auto;
      width: auto;
      text-align: left;
      padding: 0 0.25rem;
    }

    .precision__point--top-left { grid-row: 2; }
    .precision__point--top-right { grid-row: 3; }
    .precision__point--bottom-left { grid-row: 4; }
    .precision__point--bottom-right { grid-row: 5; }

    .precision__point--top-left p,
    .precision__point--bottom-right p {
      margin-left: 0;
    }

    .precision__point h3 {
      font-size: 12px;
    }

    .precision__point p {
      font-size: 13px;
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    .precision {
      padding: 3rem 0 2.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.precision.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.precision.settings.heading",
      "default": "0.5 mm precision"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.precision.settings.eyebrow",
      "default": "Micro-infusion"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.precision.settings.text",
      "default": "Engineered for controlled, targeted scalp application, Riavâte’s 0.5 mm micro-infusion system uses precision micro-touchpoints to apply the cosmetic formula consistently across the scalp."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.precision.settings.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.precision.settings.image_alt",
      "default": "Riavâte 0.5 mm micro-infusion device"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.precision.blocks.point.name",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "t:sections.precision.blocks.point.position",
          "options": [
            { "value": "top-left", "label": "t:sections.precision.options.top_left" },
            { "value": "top-right", "label": "t:sections.precision.options.top_right" },
            { "value": "bottom-left", "label": "t:sections.precision.options.bottom_left" },
            { "value": "bottom-right", "label": "t:sections.precision.options.bottom_right" }
          ],
          "default": "top-left"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.precision.blocks.point.title",
          "default": "Even distribution"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.precision.blocks.point.text",
          "default": "Helps distribute the cosmetic serum consistently across the treatment area."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "t:sections.precision.name" }
  ]
}
{% endschema %}

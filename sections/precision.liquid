<section class="precision">
  <div class="precision__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="precision__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="precision__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="precision__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>

  <div class="precision__stage">
    <svg class="precision__connectors" viewBox="0 0 1180 480" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      {%- comment -%} Top-left: down then right into device {%- endcomment -%}
      <path d="M340 78 V168 H505" stroke="#cfcfcf" stroke-width="1" vector-effect="non-scaling-stroke"/>
      {%- comment -%} Top-right: down then left into device {%- endcomment -%}
      <path d="M840 78 V168 H675" stroke="#cfcfcf" stroke-width="1" vector-effect="non-scaling-stroke"/>
      {%- comment -%} Bottom-left: up then right into device {%- endcomment -%}
      <path d="M340 318 V228 H505" stroke="#cfcfcf" stroke-width="1" vector-effect="non-scaling-stroke"/>
      {%- comment -%} Bottom-right: up then left into device {%- endcomment -%}
      <path d="M840 318 V228 H675" stroke="#cfcfcf" stroke-width="1" vector-effect="non-scaling-stroke"/>
    </svg>

    <div class="precision__lines precision__lines--left">
      <img class="precision__line precision__line--top" src="{{ 'precision-connector-left-top.png' | asset_url }}" alt="" width="296" height="88">
      <img class="precision__line precision__line--bottom" src="{{ 'precision-connector-left-bottom.png' | asset_url }}" alt="" width="450" height="144">
    </div>
    <div class="precision__lines precision__lines--right">
      <img class="precision__line precision__line--top" src="{{ 'precision-connector-right-top.png' | asset_url }}" alt="" width="296" height="88">
      <img class="precision__line precision__line--bottom" src="{{ 'precision-connector-right-bottom.png' | asset_url }}" alt="" width="450" height="144">
    </div>

    <div class="precision__media">
      <div class="precision__frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              widths: '300, 500, 700, 900',
              sizes: '(min-width: 750px) 280px, 70vw',
              alt: section.settings.image_alt,
              loading: 'lazy',
              class: 'precision__image'
          }}
        {%- else -%}
          <img
            class="precision__image"
            src="{{ 'precision-device.png' | asset_url }}"
            alt="{{ section.settings.image_alt | escape }}"
            width="509"
            height="746"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <article class="precision__point precision__point--{{ block.settings.position }}" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .precision {
    padding: 4.75rem 0 4.25rem;
    background: #ffffff;
    color: #111111;
  }

  .precision__intro {
    width: min(780px, calc(100% - 2.5rem));
    margin: 0 auto;
    text-align: center;
  }

  .precision__heading {
    margin: 0;
    color: #121a43;
    font-family: Montserrat, sans-serif;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .precision__eyebrow {
    margin: 0.65rem 0 0;
    color: #111111;
    font-family: Montserrat, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.38em;
    text-transform: uppercase;
  }

  .precision__text {
    margin: 0.85rem auto 0;
    max-width: 46rem;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .precision__stage {
    --device: 236px;
    position: relative;
    width: min(1180px, calc(100% - 2rem));
    height: 480px;
    margin: 1.5rem auto 0;
  }

  .precision__connectors {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .precision__media {
    position: absolute;
    top: 12px;
    left: 50%;
    z-index: 1;
    width: var(--device);
    transform: translateX(-50%);
  }

  .precision__frame {
    height: auto;
  }

  .precision__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .precision__lines {
    display: none;
  }

  .precision__line {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    object-fit: fill;
  }

  .precision__point h3 {
    margin: 0;
    color: #111111;
    font-family: Montserrat, sans-serif;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .precision__point p {
    margin: 0.45rem 0 0;
    max-width: 15.25rem;
    color: #1a1a1a;
    font-family: Montserrat, sans-serif;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.45;
  }

  .precision__point--top-left,
  .precision__point--top-right,
  .precision__point--bottom-left,
  .precision__point--bottom-right {
    position: absolute;
    z-index: 2;
    width: 220px;
  }

  .precision__point--top-left {
    top: 4px;
    left: 110px;
    text-align: left;
  }

  .precision__point--top-right {
    top: 4px;
    right: 110px;
    text-align: left;
  }

  .precision__point--bottom-left {
    top: 328px;
    left: 110px;
    text-align: left;
  }

  .precision__point--bottom-right {
    top: 328px;
    right: 110px;
    text-align: left;
  }

  @media screen and (max-width: 989px) {
    .precision__connectors {
      display: none;
    }

    .precision__stage {
      --device: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(108px, 168px) minmax(0, 1fr);
      grid-template-areas:
        "top-left . top-right"
        "lines-left media lines-right"
        "bottom-left . bottom-right";
      align-items: center;
      width: min(720px, calc(100% - 1.5rem));
      height: auto;
      margin-top: 2.25rem;
      column-gap: 0.55rem;
      row-gap: 0.85rem;
    }

    .precision__media,
    .precision__point,
    .precision__lines,
    .precision__point--top-left,
    .precision__point--top-right,
    .precision__point--bottom-left,
    .precision__point--bottom-right {
      position: static;
      top: auto;
      right: auto;
      left: auto;
      width: auto;
      transform: none;
    }

    .precision__media {
      grid-area: media;
      width: 100%;
      height: auto;
      margin: 0;
    }

    .precision__frame,
    .precision__image {
      height: auto;
    }

    .precision__lines {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
      width: 100%;
      max-width: 168px;
      align-self: center;
    }

    .precision__lines--left { grid-area: lines-left; justify-self: end; align-items: flex-end; }
    .precision__lines--right { grid-area: lines-right; justify-self: start; align-items: flex-start; }

    .precision__line,
    .precision__line--top,
    .precision__line--bottom,
    .precision__lines--left .precision__line--top,
    .precision__lines--right .precision__line--top,
    .precision__lines--left .precision__line--bottom,
    .precision__lines--right .precision__line--bottom {
      position: static;
      top: auto;
      right: auto;
      left: auto;
      height: auto;
      object-fit: contain;
    }

    .precision__line--top { width: 72%; }
    .precision__line--bottom { width: 100%; }

    .precision__point--top-left { grid-area: top-left; }
    .precision__point--top-right { grid-area: top-right; text-align: right; }
    .precision__point--bottom-left { grid-area: bottom-left; }
    .precision__point--bottom-right { grid-area: bottom-right; text-align: right; }

    .precision__point p {
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    .precision {
      padding: 3rem 0 2.5rem;
    }

    .precision__stage {
      grid-template-columns: minmax(0, 1fr) minmax(96px, 132px) minmax(0, 1fr);
      column-gap: 0.4rem;
      row-gap: 0.7rem;
    }

    .precision__point h3 {
      font-size: 11px;
    }

    .precision__point p {
      font-size: 12px;
      line-height: 1.35;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.precision.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.precision.settings.heading",
      "default": "0.5 mm precision"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.precision.settings.eyebrow",
      "default": "Micro-infusion"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.precision.settings.text",
      "default": "Engineered for controlled, targeted scalp application, Riavâte’s 0.5 mm micro-infusion system uses precision micro-touchpoints to apply the cosmetic formula consistently across the scalp."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.precision.settings.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.precision.settings.image_alt",
      "default": "Riavâte 0.5 mm micro-infusion device"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.precision.blocks.point.name",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "t:sections.precision.blocks.point.position",
          "options": [
            { "value": "top-left", "label": "t:sections.precision.options.top_left" },
            { "value": "top-right", "label": "t:sections.precision.options.top_right" },
            { "value": "bottom-left", "label": "t:sections.precision.options.bottom_left" },
            { "value": "bottom-right", "label": "t:sections.precision.options.bottom_right" }
          ],
          "default": "top-left"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.precision.blocks.point.title",
          "default": "Even distribution"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.precision.blocks.point.text",
          "default": "Helps distribute the cosmetic serum consistently across the treatment area."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "t:sections.precision.name" }
  ]
}
{% endschema %}

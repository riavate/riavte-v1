<section class="precision">
  <div class="precision__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="precision__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="precision__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="precision__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>

  <div class="precision__stage">
    <div class="precision__media">
      <span class="precision__bracket precision__bracket--left" aria-hidden="true"></span>
      <span class="precision__bracket precision__bracket--right" aria-hidden="true"></span>
      <div class="precision__frame">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag:
            widths: '300, 500, 700, 900',
            sizes: '(min-width: 750px) 320px, 70vw',
            alt: section.settings.image_alt,
            loading: 'lazy',
            class: 'precision__image'
        }}
      {%- else -%}
        <img
          class="precision__image"
          src="{{ 'precision-device.jpg' | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="256"
          height="384"
          loading="lazy"
        >
      {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <article class="precision__point precision__point--{{ block.settings.position }}" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .precision {
    padding: 4.5rem 0 3.5rem;
    background: #ffffff;
    color: #111111;
  }

  .precision__intro {
    width: min(780px, calc(100% - 2.5rem));
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .precision__heading {
    margin: 0;
    color: #111111;
    font-size: clamp(1.85rem, 3.1vw, 2.35rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .precision__eyebrow {
    margin: 0.7rem 0 0;
    color: #1a1a1a;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .precision__text {
    margin: 0.85rem auto 0;
    max-width: 46rem;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .precision__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(190px, 260px) minmax(0, 1fr);
    grid-template-areas:
      "top-left media top-right"
      "bottom-left media bottom-right";
    column-gap: clamp(8.5rem, 13vw, 11.5rem);
    row-gap: 3.25rem;
    align-items: center;
    width: min(1080px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .precision__media {
    position: relative;
    grid-area: media;
    z-index: 1;
    width: min(250px, 100%);
    margin-inline: auto;
  }

  .precision__frame {
    height: 270px;
    overflow: hidden;
  }

  .precision__image {
    width: 100%;
    height: 168%;
    max-height: none;
    object-fit: cover;
    object-position: top center;
  }

  .precision__bracket {
    position: absolute;
    top: 30%;
    height: 44%;
    width: clamp(120px, 14vw, 180px);
    border-color: #d5d5d5;
    border-style: solid;
    pointer-events: none;
  }

  .precision__bracket--left {
    right: calc(100% - 36px);
    border-width: 1px 1px 1px 0;
    transform-origin: right center;
  }

  .precision__bracket--right {
    left: calc(100% - 36px);
    border-width: 1px 0 1px 1px;
    transform-origin: left center;
  }

  .precision__point h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .precision__point p {
    margin: 0.4rem 0 0;
    max-width: 15.5rem;
    color: #2a2a2a;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .precision__point--top-left,
  .precision__point--bottom-left {
    justify-self: end;
  }

  .precision__point--top-right,
  .precision__point--bottom-right {
    justify-self: start;
    text-align: right;
  }

  .precision__point--top-left { grid-area: top-left; align-self: start; }
  .precision__point--bottom-left { grid-area: bottom-left; align-self: end; padding-top: 3.25rem; }
  .precision__point--top-right { grid-area: top-right; align-self: start; }
  .precision__point--bottom-right { grid-area: bottom-right; align-self: end; padding-top: 3.25rem; }

  .precision__point--top-right p,
  .precision__point--bottom-right p {
    margin-left: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .precision__bracket {
      transform: scaleX(0);
    }

    .precision__stage.is-drawn .precision__bracket {
      animation: precision-draw 0.95s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .precision__stage.is-drawn .precision__bracket--right {
      animation-delay: 0.14s;
    }
  }

  @keyframes precision-draw {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media screen and (max-width: 989px) {
    .precision__stage {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "media media"
        "top-left top-right"
        "bottom-left bottom-right";
    }

    .precision__image {
      max-height: 320px;
    }

    .precision__bracket {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .precision {
      padding: 3rem 0 2.5rem;
    }

    .precision__stage {
      grid-template-columns: 1fr;
      grid-template-areas:
        "media"
        "top-left"
        "top-right"
        "bottom-left"
        "bottom-right";
    }

    .precision__point,
    .precision__point--top-left,
    .precision__point--bottom-left,
    .precision__point--top-right,
    .precision__point--bottom-right {
      justify-self: stretch;
      text-align: left;
    }

    .precision__point p,
    .precision__point--top-right p,
    .precision__point--bottom-right p {
      margin-left: 0;
      max-width: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var stages = document.querySelectorAll('.precision__stage');
    if (!stages.length) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      stages.forEach(function (stage) {
        stage.classList.add('is-drawn');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-drawn');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.35 }
    );

    stages.forEach(function (stage) {
      observer.observe(stage);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.precision.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.precision.settings.heading",
      "default": "0.5 mm precision"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.precision.settings.eyebrow",
      "default": "Micro-infusion"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.precision.settings.text",
      "default": "Engineered for controlled, targeted scalp application, Riavâte’s 0.5 mm micro-infusion system uses precision micro-touchpoints to apply the cosmetic formula consistently across the scalp."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.precision.settings.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.precision.settings.image_alt",
      "default": "Riavâte 0.5 mm micro-infusion device"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.precision.blocks.point.name",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "t:sections.precision.blocks.point.position",
          "options": [
            { "value": "top-left", "label": "t:sections.precision.options.top_left" },
            { "value": "top-right", "label": "t:sections.precision.options.top_right" },
            { "value": "bottom-left", "label": "t:sections.precision.options.bottom_left" },
            { "value": "bottom-right", "label": "t:sections.precision.options.bottom_right" }
          ],
          "default": "top-left"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.precision.blocks.point.title",
          "default": "Even distribution"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.precision.blocks.point.text",
          "default": "Helps distribute the cosmetic serum consistently across the treatment area."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "t:sections.precision.name" }
  ]
}
{% endschema %}

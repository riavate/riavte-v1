<section class="precision">
  <div class="precision__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="precision__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="precision__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="precision__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>

  <div class="precision__stage">
    <div class="precision__lines precision__lines--left">
      <img class="precision__line precision__line--top" src="{{ 'precision-line-left-top.png' | asset_url }}" alt="" width="1024" height="198">
      <img class="precision__line precision__line--bottom" src="{{ 'precision-line-left-bottom.png' | asset_url }}" alt="" width="650" height="230">
    </div>
    <div class="precision__lines precision__lines--right">
      <img class="precision__line precision__line--top" src="{{ 'precision-line-right-top.png' | asset_url }}" alt="" width="1024" height="199">
      <img class="precision__line precision__line--bottom" src="{{ 'precision-line-right-bottom.png' | asset_url }}" alt="" width="648" height="230">
    </div>
    <div class="precision__media">
      <div class="precision__frame">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag:
            widths: '300, 500, 700, 900',
            sizes: '(min-width: 750px) 320px, 70vw',
            alt: section.settings.image_alt,
            loading: 'lazy',
            class: 'precision__image'
        }}
      {%- else -%}
        <img
          class="precision__image"
          src="{{ 'precision-device.jpg' | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="256"
          height="384"
          loading="lazy"
        >
      {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <article class="precision__point precision__point--{{ block.settings.position }}" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .precision {
    padding: 4.5rem 0 3.5rem;
    background: #ffffff;
    color: #111111;
  }

  .precision__intro {
    width: min(780px, calc(100% - 2.5rem));
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .precision__heading {
    margin: 0;
    color: #1a2a6e;
    font-size: clamp(1.7rem, 2.6vw, 2.15rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .precision__eyebrow {
    margin: 0.85rem 0 0;
    color: #2c2c2c;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .precision__text {
    margin: 0.85rem auto 0;
    max-width: 46rem;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .precision__stage {
    --device: 250px;
    --line: 168px;
    position: relative;
    width: min(1040px, calc(100% - 3rem));
    height: 430px;
    margin: 4.25rem auto 0.5rem;
  }

  .precision__media {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    width: var(--device);
    height: 400px;
    margin-inline: auto;
  }

  .precision__frame {
    height: 100%;
  }

  .precision__image {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: contain;
    object-position: top center;
  }

  .precision__lines {
    display: contents;
  }

  .precision__line {
    position: absolute;
    z-index: 0;
    height: auto;
    pointer-events: none;
    transform: rotateY(360deg);
  }

  .precision__lines--left .precision__line {
    right: calc(50% + var(--device) / 2 + 16px);
    transform-origin: center center;
  }

  .precision__lines--right .precision__line {
    left: calc(50% + var(--device) / 2 + 16px);
    transform-origin: center center;
  }

  .precision__line--top {
    top: 154px;
    width: 148px;
    height: 42px;
    object-fit: cover;
  }

  .precision__lines--left .precision__line--top {
    object-position: right top;
  }

  .precision__lines--right .precision__line--top {
    object-position: left top;
  }

  .precision__line--bottom {
    top: 214px;
    width: 220px;
    height: 16px;
    object-fit: cover;
  }

  .precision__lines--left .precision__line--bottom {
    object-position: right bottom;
  }

  .precision__lines--right .precision__line--bottom {
    object-position: left bottom;
  }

  .precision__point h3 {
    margin: 0;
    color: #111111;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .precision__point p {
    margin: 0.35rem 0 0;
    max-width: 14.5rem;
    color: #3a3a3a;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  .precision__point--top-left,
  .precision__point--top-right,
  .precision__point--bottom-left,
  .precision__point--bottom-right {
    position: absolute;
    width: 210px;
  }

  .precision__point--top-left { top: 86px; left: 8px; }
  .precision__point--top-right { top: 86px; right: 8px; text-align: right; }
  .precision__point--bottom-left { top: 292px; left: 8px; }
  .precision__point--bottom-right { top: 292px; right: 8px; text-align: right; }

  .precision__point--top-right p,
  .precision__point--bottom-right p {
    margin-left: auto;
  }


  @media screen and (max-width: 989px) {
    .precision__stage {
      --device: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(108px, 168px) minmax(0, 1fr);
      grid-template-areas:
        "top-left . top-right"
        "lines-left media lines-right"
        "bottom-left . bottom-right";
      align-items: center;
      width: min(720px, calc(100% - 1.5rem));
      height: auto;
      margin-top: 2.25rem;
      column-gap: 0.55rem;
      row-gap: 0.85rem;
    }

    .precision__media,
    .precision__point,
    .precision__lines,
    .precision__point--top-left,
    .precision__point--top-right,
    .precision__point--bottom-left,
    .precision__point--bottom-right {
      position: static;
      top: auto;
      right: auto;
      left: auto;
      width: auto;
    }

    .precision__media {
      grid-area: media;
      width: 100%;
      height: auto;
      margin: 0;
    }

    .precision__frame,
    .precision__image {
      height: auto;
    }

    .precision__lines {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
      width: 100%;
      max-width: 168px;
      align-self: center;
    }

    .precision__lines--left { grid-area: lines-left; justify-self: end; align-items: flex-end; }
    .precision__lines--right { grid-area: lines-right; justify-self: start; align-items: flex-start; }

    .precision__line,
    .precision__line--top,
    .precision__line--bottom {
      position: static;
      top: auto;
      right: auto;
      left: auto;
      height: auto;
      object-fit: contain;
    }

    .precision__line--top { width: 72%; }
    .precision__line--bottom { width: 100%; }

    .precision__point--top-left { grid-area: top-left; }
    .precision__point--top-right { grid-area: top-right; text-align: right; }
    .precision__point--bottom-left { grid-area: bottom-left; }
    .precision__point--bottom-right { grid-area: bottom-right; text-align: right; }

    .precision__point p {
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    .precision {
      padding: 3rem 0 2.5rem;
    }

    .precision__intro {
      margin-bottom: 1.5rem;
    }

    .precision__stage {
      grid-template-columns: minmax(0, 1fr) minmax(96px, 132px) minmax(0, 1fr);
      column-gap: 0.4rem;
      row-gap: 0.7rem;
    }

    .precision__point h3 {
      font-size: 11px;
    }

    .precision__point p {
      font-size: 12px;
      line-height: 1.35;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.precision.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.precision.settings.heading",
      "default": "0.5 mm precision"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.precision.settings.eyebrow",
      "default": "Micro-infusion"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.precision.settings.text",
      "default": "Engineered for controlled, targeted scalp application, Riavâte’s 0.5 mm micro-infusion system uses precision micro-touchpoints to apply the cosmetic formula consistently across the scalp."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.precision.settings.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.precision.settings.image_alt",
      "default": "Riavâte 0.5 mm micro-infusion device"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.precision.blocks.point.name",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "t:sections.precision.blocks.point.position",
          "options": [
            { "value": "top-left", "label": "t:sections.precision.options.top_left" },
            { "value": "top-right", "label": "t:sections.precision.options.top_right" },
            { "value": "bottom-left", "label": "t:sections.precision.options.bottom_left" },
            { "value": "bottom-right", "label": "t:sections.precision.options.bottom_right" }
          ],
          "default": "top-left"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.precision.blocks.point.title",
          "default": "Even distribution"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.precision.blocks.point.text",
          "default": "Helps distribute the cosmetic serum consistently across the treatment area."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "t:sections.precision.name" }
  ]
}
{% endschema %}

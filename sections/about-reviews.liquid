<section class="about-reviews">
  <div class="about-reviews__inner">
    <div class="about-reviews__head">
      <h2 class="about-reviews__heading">{{ section.settings.heading | escape }}</h2>
      <span class="about-reviews__rule" aria-hidden="true"></span>
    </div>

    <ul class="about-reviews__grid">
      {%- for block in section.blocks -%}
        <li class="about-reviews__card" {{ block.shopify_attributes }}>
          <div class="about-reviews__photo">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  widths: '320, 480, 720',
                  sizes: '(min-width: 990px) 280px, 100vw',
                  alt: block.settings.name,
                  loading: 'lazy',
                  class: 'about-reviews__image'
              }}
            {%- else -%}
              <img
                class="about-reviews__image"
                src="{{ block.settings.fallback | asset_url }}"
                alt="{{ block.settings.name | escape }}"
                width="700"
                height="450"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          <div class="about-reviews__body">
            <p class="about-reviews__stars" aria-label="{{ section.settings.stars_label | escape }}">★★★★★</p>
            <p class="about-reviews__date">{{ block.settings.date | escape }}</p>
            <p class="about-reviews__name">{{ block.settings.name | escape }}</p>
            <div class="about-reviews__quote">{{ block.settings.quote }}</div>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <p class="about-reviews__more">
        <a class="about-reviews__button" href="{{ section.settings.button_link | default: '#' }}">
          <span class="about-reviews__button-label">{{ section.settings.button_label | escape }}</span>
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .about-reviews {
    padding: 3.25rem 0 4.5rem;
    background: #ffffff;
    color: #111111;
  }

  .about-reviews__inner {
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .about-reviews__head {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.55rem;
    width: 100%;
    margin-bottom: 1.6rem;
  }

  .about-reviews__heading {
    margin: 0;
    padding: 0;
    color: #111111;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .about-reviews__rule {
    display: block;
    width: 100%;
    height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-top: 1px solid #111111;
    background: none;
    transform: none;
  }

  .about-reviews__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-reviews__card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 0.5rem 0.5rem 0.95rem;
    border: 1px solid #1a1a1a;
    border-radius: 1.15rem;
    background: #ffffff;
  }

  .about-reviews__photo {
    overflow: hidden;
    border-radius: 0.8rem;
  }

  .about-reviews__image {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: center;
  }

  .about-reviews__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.85rem 0.35rem 0.1rem;
  }

  .about-reviews__stars {
    margin: 0;
    color: #3b6cff;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    line-height: 1;
    text-align: right;
  }

  .about-reviews__date {
    margin: 0.28rem 0 0.75rem;
    color: #9aa0a8;
    font-size: 0.68rem;
    text-align: right;
  }

  .about-reviews__name {
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .about-reviews__quote {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .about-reviews__quote p {
    margin: 0 0 0.35rem;
  }

  .about-reviews__quote p:last-child {
    margin-bottom: 0;
  }

  .about-reviews__more {
    margin: 2rem 0 0;
    text-align: center;
  }

  .about-reviews__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 224px;
    max-width: 100%;
    height: 44px;
    padding: 0 1.25rem;
    border: 1px solid transparent;
    border-radius: 22px;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(90deg, #121a43 0%, #2d42a9 100%) border-box;
    text-decoration: none;
  }

  .about-reviews__button-label {
    background-image: linear-gradient(90deg, #121a43 0%, #2d42a9 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  @media screen and (max-width: 989px) {
    .about-reviews__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .about-reviews {
      padding: 2.5rem 0 3.25rem;
    }

    .about-reviews__inner {
      width: min(1180px, calc(100% - 2.5rem));
    }

    .about-reviews__grid {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin-inline: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_reviews.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about_reviews.settings.heading",
      "default": "Reviews 10457"
    },
    {
      "type": "text",
      "id": "stars_label",
      "label": "t:sections.about_reviews.settings.stars_label",
      "default": "5 out of 5 stars"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.about_reviews.settings.button_label",
      "default": "Show more reviews"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.about_reviews.settings.button_link"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.about_reviews.blocks.review.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.about_reviews.blocks.review.image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "t:sections.about_reviews.blocks.review.fallback",
          "default": "product-review-1.jpg"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.about_reviews.blocks.review.name_label",
          "default": "James R."
        },
        {
          "type": "text",
          "id": "date",
          "label": "t:sections.about_reviews.blocks.review.date",
          "default": "18 September 2026"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:sections.about_reviews.blocks.review.quote",
          "default": "<p>“Really easy to add to my routine.”</p><p>The kit feels premium and straightforward to use.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.about_reviews.name"
    }
  ]
}
{% endschema %}

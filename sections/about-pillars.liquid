<section class="about-pillars">
  <div class="about-pillars__inner">
    <div class="about-pillars__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about-pillars__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-pillars__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="about-pillars__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <ol class="about-pillars__list">
      {%- for block in section.blocks -%}
        <li class="about-pillars__item" {{ block.shopify_attributes }}>
          <p class="about-pillars__index">0{{ forloop.index }}</p>
          {%- if block.settings.title != blank -%}
            <h3 class="about-pillars__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="about-pillars__item-text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .about-pillars {
    background: #ffffff;
    color: #121a43;
  }

  .about-pillars__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .about-pillars__intro {
    max-width: 40rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .about-pillars__eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .about-pillars__heading {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .about-pillars__text {
    margin-top: 1rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.7;
    color: #3d4566;
  }

  .about-pillars__text p {
    margin: 0;
  }

  .about-pillars__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-pillars__index {
    margin: 0 0 0.85rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #0037ae;
  }

  .about-pillars__title {
    margin: 0 0 0.65rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about-pillars__item-text {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.65;
    color: #3d4566;
  }

  @media screen and (max-width: 989px) {
    .about-pillars__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .about-pillars__inner {
      padding: 3.5rem 1.25rem;
    }

    .about-pillars__list {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_pillars.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.about_pillars.settings.eyebrow",
      "default": "The system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about_pillars.settings.heading",
      "default": "Precision in the device. Purpose in the formula."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.about_pillars.settings.text",
      "default": "<p>One considered system, built around a precise applicator and a concentrated serum.</p>"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "t:sections.about_pillars.blocks.pillar.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.about_pillars.blocks.pillar.title",
          "default": "Precision"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.about_pillars.blocks.pillar.text",
          "default": "Designed for controlled and consistent micro-infusion application."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.about_pillars.name",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Even distribution", "text": "Helps distribute the cosmetic serum consistently across the treatment area." } },
        { "type": "pillar", "settings": { "title": "0.5 mm precision", "text": "Designed for controlled and consistent micro-infusion application." } },
        { "type": "pillar", "settings": { "title": "Gold-plated tips", "text": "Precision micro-touchpoints engineered for a refined application experience." } },
        { "type": "pillar", "settings": { "title": "Targeted application", "text": "Helps apply the formula precisely across targeted areas of the scalp." } }
      ]
    }
  ]
}
{% endschema %}

<section class="about-hero-alt">
  <div class="about-hero-alt__inner">

    <div class="about-hero-alt__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '480, 800, 1200',
            sizes: '(min-width: 990px) 46vw, 100vw',
            alt: section.settings.image_alt,
            class: 'about-hero-alt__image'
        }}
      {%- else -%}
        <img
          class="about-hero-alt__image"
          src="{{ 'about-hero.jpg' | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="1024"
          height="992"
        >
      {%- endif -%}
    </div>

    <div class="about-hero-alt__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about-hero-alt__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="about-hero-alt__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="about-hero-alt__text rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

  </div>

  {%- if section.settings.labels != blank -%}
    <ul class="about-hero-alt__labels">
      {%- assign labels = section.settings.labels | newline_to_br | split: '<br />' -%}
      {%- for label in labels -%}
        {%- assign item = label | strip -%}
        {%- if item != blank -%}
          <li>{{ item | escape }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% stylesheet %}
  .about-hero-alt {
    background: #ffffff;
    color: #121a43;
  }

  .about-hero-alt__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
    padding: 5.5rem 1.5rem 2.5rem;
  }

  .about-hero-alt__media {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    border-radius: 1.25rem;
    overflow: hidden;
  }

  .about-hero-alt__copy {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .about-hero-alt__eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8b93a7;
  }

  .about-hero-alt__heading {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .about-hero-alt__text {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.7;
    color: #3d4566;
  }

  .about-hero-alt__text p {
    margin: 0;
  }

  .about-hero-alt__text p + p {
    margin-top: 1rem;
  }

  .about-hero-alt__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 0.96;
    object-fit: cover;
  }

  .about-hero-alt__labels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 3.5rem;
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 4.5rem;
    list-style: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #1a2744;
  }

  @media screen and (max-width: 989px) {
    .about-hero-alt__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding: 3.5rem 1.25rem 3rem;
    }

    .about-hero-alt__media {
      grid-column: 1;
      grid-row: 1;
    }

    .about-hero-alt__copy {
      grid-column: 1;
      grid-row: 2;
    }

    .about-hero-alt__labels {
      gap: 1rem 1.5rem;
      padding-bottom: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Hero Alternate",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About Riavâte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A more precise approach to scalp care."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Riavâte was created around a simple idea: modern scalp care should be considered, targeted and built with precision.</p><p>We bring together precision micro-infusion technology and Cuprofuse®, our concentrated serum led by GHK-Cu, to create a considered approach to modern scalp care.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Riavâte micro-infusion device"
    },
    {
      "type": "textarea",
      "id": "labels",
      "label": "Labels",
      "default": "Precision technology\nPeptide-led formula\nModern scalp care"
    }
  ],
  "presets": [
    {
      "name": "About Hero Alternate"
    }
  ]
}
{% endschema %}
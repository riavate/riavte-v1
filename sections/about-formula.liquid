<section class="about-formula">
  <div class="about-formula__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '800, 1400, 2000',
          sizes: '100vw',
          alt: '',
          class: 'about-formula__image'
      }}
    {%- else -%}
      <img class="about-formula__image" src="{{ 'about-molecule.jpg' | asset_url }}" alt="" width="1024" height="443">
    {%- endif -%}
  </div>
  <div class="about-formula__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="about-formula__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="about-formula__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="about-formula__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="about-formula__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="about-formula__features">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <p class="about-formula__feature-title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="about-formula__feature-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .about-formula {
    position: relative;
    overflow: hidden;
    color: #ffffff;
    background: #0037ae;
  }

  .about-formula__media {
    position: absolute;
    inset: 0;
  }

  .about-formula__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-formula__inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }

  .about-formula__eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .about-formula__heading {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about-formula__subheading {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about-formula__text {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
  }

  .about-formula__text p {
    margin: 0;
  }

  .about-formula__features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .about-formula__feature-title {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-formula__feature-text {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }

  @media screen and (max-width: 749px) {
    .about-formula__inner {
      padding: 4rem 1.25rem;
    }

    .about-formula__features {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_formula.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.about_formula.settings.eyebrow",
      "default": "The formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about_formula.settings.heading",
      "default": "Cuprofuse®"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.about_formula.settings.subheading",
      "default": "Our concentrated serum"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.about_formula.settings.text",
      "default": "<p>More than a single hero ingredient. Cuprofuse® brings GHK-Cu together with a precisely configured combination of selected molecules and scalp-care ingredients in one concentrated formula.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.about_formula.settings.image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.about_formula.blocks.feature.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.about_formula.blocks.feature.title",
          "default": "GHK-Cu"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.about_formula.blocks.feature.text",
          "default": "The copper peptide at the heart of the formula."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:sections.about_formula.name",
      "blocks": [
        { "type": "feature", "settings": { "title": "GHK-Cu", "text": "The copper peptide at the heart of the formula." } },
        { "type": "feature", "settings": { "title": "Precision formulated", "text": "A considered combination of selected scalp-care ingredients." } },
        { "type": "feature", "settings": { "title": "Made for micro-infusion", "text": "Developed to complement the Riavâte application system." } }
      ]
    }
  ]
}
{% endschema %}

<section class="peptide">
  <div class="peptide__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="peptide__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="peptide__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="peptide__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <ul class="peptide__grid">
    {%- for block in section.blocks -%}
      <li class="peptide__item" {{ block.shopify_attributes }}>
        <span class="peptide__icon">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 160
              | image_tag: widths: '80, 160', sizes: '72px', alt: '', class: 'peptide__icon-image'
            }}
          {%- else -%}
            {%- case block.settings.icon -%}
              {%- when 'fuller' -%}
                <img src="{{ 'icon-fuller.png' | asset_url }}" alt="" width="72" height="72">
              {%- when 'molecule' -%}
                <img src="{{ 'icon-molecule.png' | asset_url }}" alt="" width="72" height="72">
              {%- when 'apply' -%}
                <img src="{{ 'icon-apply.png' | asset_url }}" alt="" width="72" height="72">
              {%- else -%}
                <img src="{{ 'icon-scalp-health.png' | asset_url }}" alt="" width="72" height="72">
            {%- endcase -%}
          {%- endif -%}
        </span>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .peptide {
    padding: 4.5rem 1.25rem 4rem;
    color: #ffffff;
    background-image: linear-gradient(124deg, #000000 8%, #021433 48%, #0037ae 100%);
  }

  .peptide__intro {
    width: min(640px, 100%);
    margin: 0 auto 2.75rem;
    text-align: center;
  }

  .peptide__eyebrow {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 3.64px;
    text-transform: uppercase;
  }

  .peptide__heading {
    margin: 0.65rem 0 0;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .peptide__text {
    margin-top: 1rem;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }

  .peptide__text p {
    margin: 0 0 0.35rem;
  }

  .peptide__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .peptide__item {
    text-align: center;
  }

  .peptide__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 76px;
    margin-bottom: 0.85rem;
  }

  .peptide__icon img,
  .peptide__icon-image {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }

  .peptide__item h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.3;
  }

  .peptide__item p {
    margin: 0.55rem auto 0;
    max-width: 16rem;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  @media screen and (max-width: 989px) {
    .peptide__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1rem;
    }
  }

  @media screen and (max-width: 549px) {
    .peptide {
      padding: 3rem 1.25rem;
    }

    .peptide__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.peptide.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.precision.settings.eyebrow",
      "default": "Our hero peptide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.precision.settings.heading",
      "default": "GHK-Cu"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.precision.settings.text",
      "default": "<p>COPPER TRIPEPTIDE-1</p><p>At the heart of Riavâte is GHK-Cu (Copper Tripeptide-1) — a copper peptide selected as the hero of our science-led scalp-care formula.</p>"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.peptide.blocks.feature.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.icon_row.blocks.item.icon",
          "options": [
            { "value": "scalp", "label": "t:sections.peptide.options.scalp" },
            { "value": "fuller", "label": "t:sections.peptide.options.fuller" },
            { "value": "molecule", "label": "t:sections.peptide.options.molecule" },
            { "value": "apply", "label": "t:sections.peptide.options.apply" }
          ],
          "default": "scalp"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.icon_row.blocks.item.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.precision.blocks.point.title",
          "default": "Scalp condition"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.precision.blocks.point.text",
          "default": "Helps support a healthy-looking, well-conditioned scalp."
        }
      ]
    }
  ],
  "presets": [
    { "name": "t:sections.peptide.name" }
  ]
}
{% endschema %}

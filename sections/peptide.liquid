<section class="peptide">
  <div class="peptide__molecule" aria-hidden="true">
    {%- if section.settings.molecule != blank -%}
      {{
        section.settings.molecule
        | image_url: width: 1200
        | image_tag: widths: '480, 720, 1200', sizes: '(min-width: 990px) 440px, 240px', alt: '', class: 'peptide__molecule-image'
      }}
    {%- else -%}
      <img
        class="peptide__molecule-image"
        src="{{ 'peptide-molecule.png' | asset_url }}"
        alt=""
        width="1024"
        height="860"
      >
    {%- endif -%}
  </div>

  <div class="peptide__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="peptide__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="peptide__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="peptide__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <ul class="peptide__grid">
    {%- for block in section.blocks -%}
      <li class="peptide__item" {{ block.shopify_attributes }}>
        <span class="peptide__icon">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 160
              | image_tag: widths: '80, 160', sizes: '52px', alt: '', class: 'peptide__icon-image'
            }}
          {%- else -%}
            {%- case block.settings.icon -%}
              {%- when 'fuller' -%}
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <path d="M18.2 7.2l.7 1.6 1.7.6-1.7.7-.7 1.6-.6-1.6-1.7-.7 1.7-.6.6-1.6Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  <path d="M31 11.5v3.2M29.4 13.1h3.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  <path d="M23.5 8.5c1.6 3.4 1.5 6.2-.2 9.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M23.2 17.6c-1.2 2.6-3.4 4.4-5.4 5.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M15.6 24.2c1.6 2.2 4.4 2.8 5.8 1.2 1-.9.8-2.4-.4-3.8" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M6 31.5c2.6 1.7 5.2 1.7 7.8 0s5.2-1.7 7.8 0 5.2 1.7 7.8 0 5.2-1.7 7.8 0 5.2 1.7 4.8 0" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M6 36.2c2.6 1.7 5.2 1.7 7.8 0s5.2-1.7 7.8 0 5.2 1.7 7.8 0 5.2-1.7 7.8 0 5.2 1.7 4.8 0" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M6 40.8c2.6 1.7 5.2 1.7 7.8 0s5.2-1.7 7.8 0 5.2 1.7 7.8 0 5.2-1.7 7.8 0 5.2 1.7 4.8 0" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                </svg>
              {%- when 'molecule' -%}
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <circle cx="24" cy="25" r="4.1" stroke="currentColor" stroke-width="1.35"/>
                  <circle cx="24" cy="9.5" r="3" stroke="currentColor" stroke-width="1.35"/>
                  <circle cx="9.5" cy="18" r="3" stroke="currentColor" stroke-width="1.35"/>
                  <circle cx="38.5" cy="18" r="3" stroke="currentColor" stroke-width="1.35"/>
                  <circle cx="13" cy="38" r="3" stroke="currentColor" stroke-width="1.35"/>
                  <circle cx="35" cy="38" r="3" stroke="currentColor" stroke-width="1.35"/>
                  <path d="M24 12.5v8.4M12.2 19.4l8.2 3.6M35.8 19.4l-8.2 3.6M15.4 35.6l5.4-7.2M32.6 35.6l-5.4-7.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                </svg>
              {%- when 'apply' -%}
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <path d="M27.5 16.5c-1.2-4.2-4.6-7-8.2-6.2-3.2.7-5.3 3.6-5.3 7.2 0 2.2.8 4 2 5.4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M16.2 22.6c-2.6 1.2-4.4 3.4-4.8 6.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M14.8 17.2c1.4 1.6 3.6 2.2 5.6 1.6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M18.6 20.2c.2 2.4-.2 4.6-1.4 6.6-1.6 2.6-2.2 4.6-1.8 7.4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M22.4 18.8c1.8 2.2 2.4 4.8 1.6 8.2-.6 2.6-.4 5 .8 7.6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M26.2 16.8c2.4 1.6 3.6 4 3.2 7-.4 2.8.2 5.2 1.6 7.6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M30.2 8.5c2.2 1.2 4.6 3.6 5.4 6.2 1 3.2.2 5.6-1.6 7.4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M33.6 11.2c1.4.2 2.6 1 3.2 2.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M31.4 14.6c1.6.6 2.4 1.8 2.2 3.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <path d="M13.2 9.2v5.2M10.6 11.8h5.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M22.6 8.2c1.8 3.6 1.6 6.6-.4 9.6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M22.1 17.6c-1.4 2.8-3.8 4.6-6 5.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M14.2 24.4c1.8 2.4 4.6 3 6.2 1.2 1.1-1.1.8-2.8-.6-4.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M6 31.5c2.6 1.7 5.2 1.7 7.8 0s5.2-1.7 7.8 0 5.2 1.7 7.8 0 5.2-1.7 7.8 0 5.2 1.7 4.8 0" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M6 36.2c2.6 1.7 5.2 1.7 7.8 0s5.2-1.7 7.8 0 5.2 1.7 7.8 0 5.2-1.7 7.8 0 5.2 1.7 4.8 0" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="M6 40.8c2.6 1.7 5.2 1.7 7.8 0s5.2-1.7 7.8 0 5.2 1.7 7.8 0 5.2-1.7 7.8 0 5.2 1.7 4.8 0" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                </svg>
            {%- endcase -%}
          {%- endif -%}
        </span>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .peptide {
    position: relative;
    overflow: hidden;
    padding: 4.75rem 1.5rem 3.75rem;
    color: #ffffff;
    background-image: linear-gradient(100deg, #05070f 0%, #071228 34%, #0b2f86 68%, #1a56e0 100%);
    border: 1px solid rgba(90, 160, 255, 0.55);
  }

  .peptide__molecule {
    position: absolute;
    top: -4.5rem;
    right: -4.25rem;
    width: min(500px, 38vw);
    pointer-events: none;
  }

  .peptide__molecule-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .peptide__intro {
    position: relative;
    z-index: 1;
    width: min(560px, calc(100% - 220px));
    margin: 0 auto 3.25rem;
    text-align: center;
  }

  .peptide__eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .peptide__heading {
    margin: 0.7rem 0 0;
    font-size: clamp(3rem, 5.4vw, 4.6rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .peptide__text {
    margin-top: 1.15rem;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
  }

  .peptide__text p {
    margin: 0;
  }

  .peptide__text p:first-child {
    margin-bottom: 0.45rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .peptide__text p:last-child {
    max-width: 38rem;
    margin-right: auto;
    margin-left: auto;
  }

  .peptide__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(1080px, 100%);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .peptide__item {
    padding: 0 1.35rem;
    text-align: center;
  }

  .peptide__item + .peptide__item {
    border-left: 1px solid rgba(255, 255, 255, 0.72);
  }

  .peptide__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 58px;
    margin-bottom: 0.85rem;
    color: #ffffff;
  }

  .peptide__icon svg {
    width: 52px;
    height: 52px;
  }

  .peptide__icon img,
  .peptide__icon-image {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  .peptide__item h3 {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .peptide__item p {
    max-width: 16rem;
    margin: 0.5rem auto 0;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.45;
  }

  @media screen and (max-width: 989px) {
    .peptide__molecule {
      top: -2rem;
      right: -4rem;
      width: 220px;
    }

    .peptide__intro {
      width: min(520px, calc(100% - 8rem));
    }

    .peptide__text p:last-child {
      margin-left: 0;
    }

    .peptide__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 0;
      margin-top: 0.5rem;
    }

    .peptide__item:nth-child(odd) {
      border-left: 0;
    }
  }

  @media screen and (max-width: 549px) {
    .peptide {
      padding: 3rem 1.25rem 2.75rem;
    }

    .peptide__molecule {
      display: none;
    }

    .peptide__intro {
      width: 100%;
      margin-bottom: 2.25rem;
      text-align: center;
    }

    .peptide__text p:last-child {
      margin-right: auto;
      margin-left: auto;
    }

    .peptide__grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .peptide__item {
      padding: 0 0.5rem;
      border-left: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.peptide.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.precision.settings.eyebrow",
      "default": "Our hero peptide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.precision.settings.heading",
      "default": "GHK-Cu"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.precision.settings.text",
      "default": "<p>COPPER TRIPEPTIDE-1</p><p>At the heart of Riavâte is GHK-Cu (Copper Tripeptide-1) — a copper peptide selected as the hero of our science-led scalp-care formula.</p>"
    },
    {
      "type": "image_picker",
      "id": "molecule",
      "label": "t:sections.precision.settings.image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.peptide.blocks.feature.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.icon_row.blocks.item.icon",
          "options": [
            { "value": "scalp", "label": "t:sections.peptide.options.scalp" },
            { "value": "fuller", "label": "t:sections.peptide.options.fuller" },
            { "value": "molecule", "label": "t:sections.peptide.options.molecule" },
            { "value": "apply", "label": "t:sections.peptide.options.apply" }
          ],
          "default": "scalp"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.icon_row.blocks.item.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.precision.blocks.point.title",
          "default": "Scalp condition"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.precision.blocks.point.text",
          "default": "Helps support a healthy-looking, well-conditioned scalp."
        }
      ]
    }
  ],
  "presets": [
    { "name": "t:sections.peptide.name" }
  ]
}
{% endschema %}

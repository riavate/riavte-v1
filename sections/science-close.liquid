<section class="science-close">
  <div class="science-close__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '800, 1400, 2000',
          sizes: '100vw',
          alt: '',
          class: 'science-close__image'
      }}
    {%- else -%}
      <img class="science-close__image" src="{{ 'about-evolved.jpg' | asset_url }}" alt="" width="1024" height="534">
    {%- endif -%}
  </div>
  <div class="science-close__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="science-close__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="science-close__heading">{{ section.settings.heading | escape | replace: ', ', ',<br>' }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="science-close__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="science-close__button" href="{{ section.settings.button_link | default: '/products/the-kit' }}">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .science-close {
    position: relative;
    overflow: hidden;
    color: #ffffff;
    background: #041433;
  }

  .science-close__media {
    position: absolute;
    inset: 0;
  }

  .science-close__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .science-close__copy {
    position: relative;
    z-index: 1;
    width: min(28rem, calc(100% - 3rem));
    margin: 0 8% 0 auto;
    padding: 5.25rem 0;
  }

  .science-close__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .science-close__heading {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .science-close__text {
    max-width: 24rem;
    margin-top: 1.15rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
  }

  .science-close__text p {
    margin: 0;
  }

  .science-close__button {
    display: inline-flex;
    margin-top: 1.6rem;
    padding: 0.85rem 1.45rem;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .science-close::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: rgba(2, 12, 40, 0.45);
    }

    .science-close__copy {
      z-index: 2;
      margin: 0 auto;
      padding: 4.25rem 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.science_close.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.science_close.settings.eyebrow",
      "default": "Riavâte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.science_close.settings.heading",
      "default": "Science-led scalp care, built with precision."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.science_close.settings.text",
      "default": "<p>Device and formula, designed together as one considered scalp-care system.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.science_close.settings.button_label",
      "default": "Shop the system →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.science_close.settings.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.science_close.settings.image"
    }
  ],
  "presets": [
    { "name": "t:sections.science_close.name" }
  ]
}
{% endschema %}

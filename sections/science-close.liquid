<section class="science-close">
  <div class="science-close__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '800, 1400, 2000',
          sizes: '100vw',
          alt: '',
          class: 'science-close__image'
      }}
    {%- else -%}
      <img
        class="science-close__image"
        src="{{ 'about-evolved.jpg' | asset_url }}"
        alt=""
        width="1600"
        height="900"
        loading="lazy"
      >
    {%- endif -%}
  </div>
  <div class="science-close__inner">
    <div class="science-close__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="science-close__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="science-close__heading">
          {{- section.settings.heading
            | escape
            | replace: ' scalp ', '<br>scalp '
            | replace: '. ', '.<br>'
            | replace: ' with ', ' with<br>'
          -}}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="science-close__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="science-close__button" href="{{ section.settings.button_link | default: '/products/the-kit' }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .science-close {
    position: relative;
    overflow: hidden;
    min-height: clamp(28rem, 52vw, 36rem);
    margin: 0;
    color: #ffffff;
    background: #000;
  }

  .science-close__media {
    position: absolute;
    inset: 0;
  }

  .science-close__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .science-close__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: min(1120px, calc(100% - 3rem));
    min-height: inherit;
    margin: 0 auto;
    padding: 5rem 0;
  }

  .science-close__copy {
    width: min(28rem, 100%);
    margin-right: clamp(0rem, 4vw, 2.5rem);
  }

  .science-close__eyebrow {
    margin: 0 0 1.1rem;
    color: rgba(255, 255, 255, 0.92);
    font-family: Montserrat, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: none;
  }

  .science-close__heading {
    margin: 0;
    max-width: 11em;
    color: #fff;
    font-family: Montserrat, sans-serif;
    font-size: clamp(2.1rem, 4.2vw, 3.25rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .science-close__text {
    max-width: 26rem;
    margin-top: 1.35rem;
    color: rgba(255, 255, 255, 0.92);
    font-family: Montserrat, sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.55;
  }

  .science-close__text p {
    margin: 0;
  }

  .science-close__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.75rem;
    min-height: 2.7rem;
    padding: 0.75rem 1.6rem;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    color: #ffffff;
    font-family: Montserrat, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    background: transparent;
  }

  .science-close__button:hover,
  .science-close__button:focus-visible {
    background: rgba(255, 255, 255, 0.08);
  }

  @media screen and (max-width: 989px) {
    .science-close {
      min-height: 0;
    }

    .science-close::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.72) 55%, #000 100%);
    }

    .science-close__inner {
      z-index: 2;
      justify-content: flex-start;
      padding: 14rem 0 3.5rem;
    }

    .science-close__copy {
      margin-right: 0;
    }

    .science-close__image {
      object-position: 20% center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.science_close.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.science_close.settings.eyebrow",
      "default": "The Riavâte System"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.science_close.settings.heading",
      "default": "Science-led scalp care. Designed with precision."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.science_close.settings.text",
      "default": "<p>Precision micro-infusion meets Cuprofuse® concentrated serum — bringing technology, formulation and modern scalp care together in one considered system.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.science_close.settings.button_label",
      "default": "Discover the system"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.science_close.settings.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.science_close.settings.image"
    }
  ],
  "presets": [
    { "name": "t:sections.science_close.name" }
  ]
}
{% endschema %}

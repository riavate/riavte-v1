{%- liquid
  assign heading_raw = section.settings.heading | escape
  assign italic = section.settings.italic_word | escape
  assign heading_lead = heading_raw
  if italic != blank
    assign needle_period = ' ' | append: italic | append: '.'
    assign needle_plain = ' ' | append: italic
    if heading_raw contains needle_period
      assign heading_lead = heading_raw | remove: needle_period | strip
    elsif heading_raw contains needle_plain
      assign heading_lead = heading_raw | remove: needle_plain | strip
    endif
  endif
-%}

<section
  class="science-inside"
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
>
  <div class="science-inside__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="science-inside__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="science-inside__heading">
        {%- if italic != blank -%}
          <span class="science-inside__heading-lead">{{ heading_lead }}</span>
          <span class="science-inside__heading-rule" aria-hidden="true"></span>
          <em class="science-inside__heading-purpose">{{ italic }}.</em>
        {%- else -%}
          {{ heading_raw }}
        {%- endif -%}
      </h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="science-inside__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    <div class="science-inside__grid">
      <div class="science-inside__feature">
        {%- if section.settings.feature_index != blank -%}
          <p class="science-inside__feature-index">{{ section.settings.feature_index | escape }}</p>
        {%- endif -%}
        {%- if section.settings.feature_title != blank -%}
          <h3 class="science-inside__feature-title">{{ section.settings.feature_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.feature_text != blank -%}
          <p class="science-inside__feature-text">{{ section.settings.feature_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              widths: '400, 700, 1000',
              sizes: '(min-width: 990px) 28vw, 100vw',
              alt: section.settings.image_alt,
              class: 'science-inside__image'
          }}
        {%- else -%}
          <img
            class="science-inside__image"
            src="{{ section.settings.fallback | asset_url }}"
            alt="{{ section.settings.image_alt | escape }}"
            width="900"
            height="700"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="science-inside__rows">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.index != blank -%}
                <p class="science-inside__index">{{ block.settings.index | escape }}</p>
              {%- endif -%}
              <div>
                {%- if block.settings.title != blank -%}
                  <h3>{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.kicker != blank -%}
                  <p class="science-inside__kicker">{{ block.settings.kicker | escape }}</p>
                {%- endif -%}
              </div>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .science-inside {
    background: #fff;
    color: #1a2f7a;
  }

  .science-inside__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3.25rem 1.5rem 5rem;
  }

  .science-inside__eyebrow {
    margin: 0 0 0.9rem;
    color: #000;
    font-family: Montserrat, sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .science-inside__heading {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: none;
    margin: 0;
    color: #121a43;
    font-family: Montserrat, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .science-inside__heading-lead {
    display: block;
    font-weight: 700;
    font-style: normal;
    text-transform: uppercase;
  }

  .science-inside__heading-rule {
    display: block;
    width: 100%;
    height: 0;
    margin: 0.12em 0 0.08em;
    padding: 0;
    border: 0;
    border-top: 1.5px solid #121a43;
    background: none;
  }

  .science-inside__heading-purpose {
    display: block;
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    color: #121a43;
  }

  .science-inside__text {
    max-width: 34rem;
    margin-top: 1.15rem;
    color: #000;
    font-family: Montserrat, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0;
  }

  .science-inside__text p {
    margin: 0;
  }

  .science-inside__grid {
    display: grid;
    grid-template-columns: minmax(210px, 0.78fr) minmax(0, 1.35fr);
    gap: 3.25rem;
    align-items: start;
    margin-top: 2.75rem;
  }

  .science-inside__feature-index {
    margin: 0 0 1.35rem;
    font-family: Montserrat, sans-serif;
    font-size: 20px;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0.03em;
    color: #d9d9d9;
  }

  .science-inside__feature-title {
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    background: linear-gradient(90deg, #121a43 0%, #2d42a9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .science-inside__feature-text {
    max-width: 18rem;
    margin: 0.55rem 0 0;
    color: #000;
    font-family: Montserrat, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0;
  }

  .science-inside__image {
    display: block;
    width: 100%;
    margin-top: 1.35rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.85rem;
  }

  .science-inside__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .science-inside__rows li {
    display: grid;
    grid-template-columns: 2.2rem minmax(10rem, 14rem) minmax(0, 1fr);
    gap: 0.75rem 1.15rem;
    align-items: start;
    padding: 1.15rem 0;
    border-top: 1px solid #e4e8ef;
  }

  .science-inside__index {
    margin: 0.15rem 0 0;
    font-family: Montserrat, sans-serif;
    font-size: 20px;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0.03em;
    color: #d9d9d9;
  }

  .science-inside__rows h3 {
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    background: linear-gradient(90deg, #121a43 0%, #2d42a9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .science-inside__kicker {
    margin: 0.28rem 0 0;
    color: #000;
    font-family: Montserrat, sans-serif;
    font-size: 0.5rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .science-inside__rows li > p {
    margin: 0;
    color: #000;
    font-family: Montserrat, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0;
  }

  @media screen and (max-width: 989px) {
    .science-inside__grid,
    .science-inside__rows li {
      grid-template-columns: 1fr;
    }

    .science-inside__rows li {
      gap: 0.35rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.science_inside.name",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.science_inside.settings.anchor"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.science_inside.settings.eyebrow",
      "default": "Inside Cuprofuse®"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.science_inside.settings.heading",
      "default": "Selected with purpose."
    },
    {
      "type": "text",
      "id": "italic_word",
      "label": "t:sections.science_inside.settings.italic_word",
      "default": "purpose"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.science_inside.settings.text",
      "default": "<p>Cuprofuse® combines its leading peptide GHK-Cu with selected cosmetic actives, each chosen for a considered role within the formula.</p>"
    },
    {
      "type": "text",
      "id": "feature_index",
      "label": "t:sections.science_inside.settings.feature_index",
      "default": "01"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "t:sections.science_inside.settings.feature_title",
      "default": "GHK-Cu / COPPER TRIPEPTIDE-1"
    },
    {
      "type": "textarea",
      "id": "feature_text",
      "label": "t:sections.science_inside.settings.feature_text",
      "default": "The leading peptide at the heart of Cuprofuse®."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.science_inside.settings.image"
    },
    {
      "type": "text",
      "id": "fallback",
      "label": "t:sections.science_inside.settings.fallback",
      "default": "science-apply.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.science_inside.settings.image_alt",
      "default": "Riavâte device applied along the hairline"
    }
  ],
  "blocks": [
    {
      "type": "active",
      "name": "t:sections.science_inside.blocks.active.name",
      "settings": [
        {
          "type": "text",
          "id": "index",
          "label": "t:sections.science_inside.blocks.active.index",
          "default": "02"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.science_inside.blocks.active.title",
          "default": "Niacinamide"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.science_inside.blocks.active.kicker",
          "default": "Scalp barrier support"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.science_inside.blocks.active.text",
          "default": "Helps condition the scalp and support its natural barrier."
        }
      ]
    }
  ],
  "presets": [
    { "name": "t:sections.science_inside.name" }
  ]
}
{% endschema %}

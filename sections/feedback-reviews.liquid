<section
  class="feedback-reviews"
  data-feedback-reviews
  data-pending-label="{{ 'sections.feedback_reviews.pending' | t | escape }}"
  data-rating-error="{{ 'sections.feedback_reviews.required_rating' | t | escape }}"
>
  <div class="feedback-reviews__intro">
    {%- if section.settings.heading != blank -%}
      <h1 class="feedback-reviews__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="feedback-reviews__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  {%- if section.settings.button_label != blank -%}
    <button class="feedback-reviews__write" type="button" data-feedback-open>
      {{ section.settings.button_label | escape }}
    </button>
  {%- endif -%}

  {%- form 'contact', id: 'FeedbackReviewForm', class: 'feedback-reviews__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="feedback-reviews__success" role="status">{{ 'sections.feedback_reviews.success' | t }}</p>
    {%- endif -%}
    {{ form.errors | default_errors }}

    <dialog class="feedback-reviews__dialog" data-feedback-dialog>
      <div class="feedback-reviews__dialog-inner">
        <div class="feedback-reviews__dialog-head">
          <h2>{{ 'sections.feedback_reviews.write_title' | t }}</h2>
          <button type="button" class="feedback-reviews__dialog-close" data-feedback-close aria-label="{{ 'sections.feedback_reviews.close' | t }}">
            ×
          </button>
        </div>

        <div class="feedback-reviews__field">
          <span>{{ 'sections.feedback_reviews.rating_label' | t }}</span>
          <div class="feedback-reviews__rating" data-feedback-stars>
            {%- for i in (1..5) -%}
              <button type="button" data-star="{{ i }}" aria-label="{{ i }} {{ 'sections.feedback_reviews.out_of_five' | t }}">★</button>
            {%- endfor -%}
          </div>
        </div>
        <input type="hidden" name="contact[rating]" value="" data-feedback-rating>

        <label class="feedback-reviews__field">
          <span>{{ 'sections.feedback_reviews.review_label' | t }}</span>
          <span class="feedback-reviews__review-box">
            <textarea
              name="contact[body]"
              rows="6"
              maxlength="2000"
              placeholder="{{ 'sections.feedback_reviews.review_placeholder' | t | escape }}"
              data-feedback-body
              required
            ></textarea>
            <span class="feedback-reviews__count" data-feedback-count>0/2000</span>
          </span>
        </label>
        <input type="hidden" name="contact[review_title]" value="" data-feedback-title>

        <div class="feedback-reviews__media">
          <label class="feedback-reviews__upload">
            <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-feedback-files>
            <span class="feedback-reviews__upload-plus" aria-hidden="true">+</span>
            <span>{{ 'sections.feedback_reviews.photos_label' | t }}</span>
            <span class="feedback-reviews__upload-count" data-feedback-upload-count>0/5</span>
          </label>
          <ul class="feedback-reviews__previews" data-feedback-previews></ul>
        </div>

        <label class="feedback-reviews__field">
          <span>{{ 'sections.feedback_reviews.your_name' | t }}</span>
          <input type="text" name="contact[name]" autocomplete="name" value="{{ customer.name | escape }}" required>
        </label>

        <label class="feedback-reviews__field">
          <span>{{ 'sections.feedback_reviews.your_email' | t }}</span>
          <input type="email" name="contact[email]" autocomplete="email" value="{{ customer.email | escape }}" required>
        </label>

        <input type="hidden" name="contact[subject]" value="{{ 'sections.feedback_reviews.write_title' | t | escape }}">
        <input type="hidden" name="contact[photo_count]" value="0" data-feedback-photo-count>
        <input type="hidden" name="contact[photo_names]" value="" data-feedback-photo-names>

        <button class="feedback-reviews__submit" type="submit">{{ 'sections.feedback_reviews.submit' | t }}</button>
      </div>
    </dialog>
  {%- endform -%}

  <div class="feedback-reviews__meta">
    <p class="feedback-reviews__tab">
      {{ 'sections.feedback_reviews.store_reviews' | t }}
      {%- if section.settings.count_label != blank -%}
        ({{ section.settings.count_label | escape }})
      {%- endif -%}
    </p>
    <div class="feedback-reviews__score">
      <span class="feedback-reviews__stars" aria-hidden="true">★★★★★</span>
      <span>{{ section.settings.score | escape }}</span>
    </div>
  </div>

  <ul class="feedback-reviews__photos" aria-label="{{ 'sections.feedback_reviews.photos' | t }}" data-feedback-photos>
    {%- for block in section.blocks -%}
      {%- if block.settings.fallback != blank or block.settings.image != blank -%}
        <li>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 400
              | image_tag:
                widths: '160, 240, 400',
                sizes: '120px',
                alt: block.settings.name,
                loading: 'lazy',
                class: 'feedback-reviews__photo-thumb'
            }}
          {%- else -%}
            <img
              class="feedback-reviews__photo-thumb"
              src="{{ block.settings.fallback | asset_url }}"
              alt="{{ block.settings.name | escape }}"
              width="120"
              height="120"
              loading="lazy"
            >
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  {%- if section.blocks.size > 0 -%}
    <div class="feedback-reviews__toolbar">
      <label class="feedback-reviews__sort-label" for="FeedbackSort-{{ section.id }}">
        {{ 'sections.feedback_reviews.sort_by' | t }}
      </label>
      <select class="feedback-reviews__sort" id="FeedbackSort-{{ section.id }}" data-feedback-sort>
        <option value="featured">{{ 'sections.feedback_reviews.sort_featured' | t }}</option>
        <option value="newest">{{ 'sections.feedback_reviews.sort_newest' | t }}</option>
        <option value="highest">{{ 'sections.feedback_reviews.sort_highest' | t }}</option>
        <option value="lowest">{{ 'sections.feedback_reviews.sort_lowest' | t }}</option>
      </select>
    </div>
  {%- endif -%}

  <ul class="feedback-reviews__list" data-feedback-list>
    {%- for block in section.blocks -%}
      <li
        class="feedback-reviews__card"
        {{ block.shopify_attributes }}
        data-rating="{{ block.settings.rating }}"
        data-date="{{ block.settings.date | escape }}"
        data-order="{{ forloop.index }}"
      >
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 900
            | image_tag:
              widths: '400, 700, 900',
              sizes: '(min-width: 750px) 220px, 100vw',
              alt: block.settings.name,
              loading: 'lazy',
              class: 'feedback-reviews__image'
          }}
        {%- elsif block.settings.fallback != blank -%}
          <img
            class="feedback-reviews__image"
            src="{{ block.settings.fallback | asset_url }}"
            alt="{{ block.settings.name | escape }}"
            width="220"
            height="220"
            loading="lazy"
          >
        {%- endif -%}
        <div class="feedback-reviews__body">
          <p class="feedback-reviews__card-stars" aria-label="{{ block.settings.rating }} {{ 'sections.feedback_reviews.out_of_five' | t }}">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </p>
          {%- if block.settings.title != blank -%}
            <h2 class="feedback-reviews__title">{{ block.settings.title | escape }}</h2>
          {%- endif -%}
          <p class="feedback-reviews__name">{{ block.settings.name | escape }}</p>
          {%- if block.settings.verified -%}
            <p class="feedback-reviews__verified">{{ section.settings.badge | escape }}</p>
          {%- endif -%}
          <div class="feedback-reviews__quote rte">{{ block.settings.quote }}</div>
          {%- if block.settings.date != blank -%}
            <p class="feedback-reviews__date">{{ block.settings.date | escape }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>

  <nav class="feedback-reviews__pages" data-feedback-pages aria-label="{{ 'sections.feedback_reviews.pagination' | t }}" hidden></nav>
</section>

{% stylesheet %}
  .feedback-reviews {
    width: min(860px, calc(100% - 2.5rem));
    margin: 2.5rem auto 4.5rem;
  }

  .feedback-reviews__intro {
    text-align: center;
  }

  .feedback-reviews__heading {
    margin: 0;
    color: #121a43;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
  }

  .feedback-reviews__text {
    margin: 1rem auto 0;
    max-width: 42rem;
    color: #4a4a4a;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .feedback-reviews__write,
  .feedback-reviews__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    border-radius: 4px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }

  .feedback-reviews__write {
    margin: 1.8rem 0 1.6rem;
    border: 1px solid #111;
    background: #fff;
    color: #111;
  }

  .feedback-reviews__write:hover,
  .feedback-reviews__write:focus-visible {
    background: #f7f7f7;
  }

  .feedback-reviews__success {
    margin: 0 0 1rem;
    padding: 0.8rem 1rem;
    border-radius: 6px;
    background: #eef7ee;
    color: #246024;
    font-size: 14px;
  }

  .feedback-reviews__dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(720px, calc(100vw - 1.5rem));
    max-height: min(90vh, 820px);
    height: fit-content;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .feedback-reviews__dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }

  .feedback-reviews__dialog-inner {
    display: grid;
    gap: 1rem;
    max-height: min(90vh, 820px);
    overflow-y: auto;
    padding: 1.4rem 1.6rem 1.5rem;
  }

  .feedback-reviews__dialog-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
  }

  .feedback-reviews__dialog-head h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .feedback-reviews__dialog-close {
    grid-column: 2;
    grid-row: 1;
    z-index: 1;
    width: 36px;
    height: 36px;
    justify-self: end;
    border: 0;
    background: transparent;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }

  .feedback-reviews__field {
    display: grid;
    gap: 0.35rem;
    font-size: 13px;
    font-weight: 600;
  }

  .feedback-reviews__field input,
  .feedback-reviews__field textarea {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid #d8d8d8;
    border-radius: 6px;
    font: inherit;
    font-weight: 400;
  }

  .feedback-reviews__rating {
    display: flex;
    gap: 0.2rem;
  }

  .feedback-reviews__rating button {
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    -webkit-text-stroke: 1.5px #e4a13a;
    font-size: 1.85rem;
    cursor: pointer;
  }

  .feedback-reviews__rating button.is-on {
    color: #e4a13a;
    -webkit-text-stroke: 1.5px #e4a13a;
  }

  .feedback-reviews__review-box {
    position: relative;
    display: block;
  }

  .feedback-reviews__review-box textarea {
    min-height: 148px;
    padding-bottom: 1.6rem;
    resize: vertical;
  }

  .feedback-reviews__count {
    position: absolute;
    right: 12px;
    bottom: 8px;
    font-size: 12px;
    font-weight: 400;
    color: #9a9a9a;
  }

  .feedback-reviews__media {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .feedback-reviews__upload {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 112px;
    height: 112px;
    border: 1px dashed #c8c8c8;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    font-size: 13px;
    text-align: center;
    color: #222;
  }

  .feedback-reviews__upload-plus {
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 400;
  }

  .feedback-reviews__upload-count {
    font-size: 12px;
    font-weight: 400;
    color: #666;
  }

  .feedback-reviews__upload input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .feedback-reviews__previews {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feedback-reviews__previews img {
    width: 112px;
    height: 112px;
    object-fit: cover;
    border-radius: 10px;
  }

  .feedback-reviews__submit {
    border: 0;
    background: #121a43;
    color: #fff;
  }

  .feedback-reviews__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid #e5e5e5;
  }

  .feedback-reviews__tab {
    margin: 0;
    padding-bottom: 0.55rem;
    border-bottom: 2px solid #111;
    font-size: 15px;
    font-weight: 700;
  }

  .feedback-reviews__score {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .feedback-reviews__stars,
  .feedback-reviews__card-stars {
    color: #2d42a9;
    letter-spacing: 0.06em;
  }

  .feedback-reviews__photos {
    display: flex;
    gap: 0.55rem;
    margin: 1.1rem 0 0;
    padding: 0 0 0.4rem;
    list-style: none;
    overflow-x: auto;
  }

  .feedback-reviews__photos li {
    flex: 0 0 112px;
  }

  .feedback-reviews__photo-thumb {
    display: block;
    width: 112px;
    height: 112px;
    object-fit: cover;
    border-radius: 8px;
  }

  .feedback-reviews__toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    margin: 1.1rem 0 0.4rem;
  }

  .feedback-reviews__sort-label,
  .feedback-reviews__sort {
    font-size: 13px;
    color: #333;
  }

  .feedback-reviews__sort {
    border: 0;
    background: transparent;
    font-weight: 600;
  }

  .feedback-reviews__list {
    display: grid;
    gap: 1rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .feedback-reviews__card {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0 1.2rem;
    border-bottom: 1px solid #ececec;
  }

  .feedback-reviews__card[hidden] {
    display: none !important;
  }

  .feedback-reviews__card:not(:has(.feedback-reviews__image)) {
    grid-template-columns: 1fr;
  }

  .feedback-reviews__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 10px;
  }

  .feedback-reviews__body {
    min-width: 0;
  }

  .feedback-reviews__card-stars,
  .feedback-reviews__name,
  .feedback-reviews__verified,
  .feedback-reviews__date {
    margin: 0;
  }

  .feedback-reviews__title {
    margin: 0.35rem 0 0.2rem;
    font-size: 16px;
    font-weight: 700;
    color: #111;
  }

  .feedback-reviews__name {
    font-size: 13px;
    font-weight: 600;
  }

  .feedback-reviews__verified {
    margin-top: 0.2rem;
    color: #2f6b2f;
    font-size: 12px;
    font-weight: 600;
  }

  .feedback-reviews__quote {
    margin-top: 0.45rem;
    color: #333;
    font-size: 14px;
    line-height: 1.5;
  }

  .feedback-reviews__date {
    margin-top: 0.7rem;
    color: #8e8e8e;
    font-size: 12px;
  }

  .feedback-reviews__pages {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin: 1.5rem 0 0;
  }

  .feedback-reviews__pages button {
    min-width: 36px;
    height: 36px;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
  }

  .feedback-reviews__pages button.is-active {
    border-color: #111;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .feedback-reviews__card {
      grid-template-columns: 1fr;
    }

    .feedback-reviews__image {
      max-width: 220px;
    }
  }
{% endstylesheet %}

{% javascript %}
(function () {
  var root = document.querySelector('[data-feedback-reviews]');
  if (!root) return;

  var list = root.querySelector('[data-feedback-list]');
  var sort = root.querySelector('[data-feedback-sort]');
  var pager = root.querySelector('[data-feedback-pages]');
  var photos = root.querySelector('[data-feedback-photos]');
  var dialog = root.querySelector('[data-feedback-dialog]');
  var form = root.querySelector('#FeedbackReviewForm');
  var openBtn = root.querySelector('[data-feedback-open]');
  var closeBtn = root.querySelector('[data-feedback-close]');
  var stars = root.querySelector('[data-feedback-stars]');
  var ratingInput = root.querySelector('[data-feedback-rating]');
  var fileInput = root.querySelector('[data-feedback-files]');
  var previews = root.querySelector('[data-feedback-previews]');
  var photoCount = root.querySelector('[data-feedback-photo-count]');
  var photoNames = root.querySelector('[data-feedback-photo-names]');
  var bodyInput = root.querySelector('[data-feedback-body]');
  var countEl = root.querySelector('[data-feedback-count]');
  var titleInput = root.querySelector('[data-feedback-title]');
  var uploadCount = root.querySelector('[data-feedback-upload-count]');
  var pendingLabel = root.getAttribute('data-pending-label') || 'Pending review';
  var ratingError = root.getAttribute('data-rating-error') || 'Please choose a star rating.';
  var storageKey = 'riavate-feedback-reviews';
  var chosenFiles = [];
  var cards = list ? Array.prototype.slice.call(list.children) : [];
  var pageSize = 8;
  var page = 1;

  function parseDate(value) {
    var time = Date.parse(value);
    return isNaN(time) ? 0 : time;
  }

  function loadPending() {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || '[]');
    } catch (error) {
      return [];
    }
  }

  function savePending(items) {
    localStorage.setItem(storageKey, JSON.stringify(items));
  }

  function starText(rating) {
    var text = '';
    for (var i = 1; i <= 5; i++) text += i <= rating ? '★' : '☆';
    return text;
  }

  function addPendingCard(review, order) {
    if (!list) return;
    var item = document.createElement('li');
    item.className = 'feedback-reviews__card';
    item.setAttribute('data-rating', String(review.rating));
    item.setAttribute('data-date', review.date);
    item.setAttribute('data-order', String(order));
    if (review.photos && review.photos[0]) {
      var image = document.createElement('img');
      image.className = 'feedback-reviews__image';
      image.src = review.photos[0];
      image.alt = review.name;
      item.appendChild(image);
    }
    var body = document.createElement('div');
    body.className = 'feedback-reviews__body';
    body.innerHTML =
      '<p class="feedback-reviews__card-stars">' + starText(review.rating) + '</p>' +
      (review.title ? '<h2 class="feedback-reviews__title"></h2>' : '') +
      '<p class="feedback-reviews__name"></p>' +
      '<p class="feedback-reviews__verified"></p>' +
      '<div class="feedback-reviews__quote rte"><p></p></div>' +
      '<p class="feedback-reviews__date"></p>';
    if (review.title) body.querySelector('.feedback-reviews__title').textContent = review.title;
    body.querySelector('.feedback-reviews__name').textContent = review.name;
    body.querySelector('.feedback-reviews__verified').textContent = pendingLabel;
    body.querySelector('.feedback-reviews__quote p').textContent = review.body;
    body.querySelector('.feedback-reviews__date').textContent = review.date;
    item.appendChild(body);
    list.insertBefore(item, list.firstChild);
    cards.unshift(item);

    if (photos && review.photos) {
      review.photos.forEach(function (src) {
        var li = document.createElement('li');
        var thumb = document.createElement('img');
        thumb.className = 'feedback-reviews__photo-thumb';
        thumb.src = src;
        thumb.alt = review.name;
        li.appendChild(thumb);
        photos.insertBefore(li, photos.firstChild);
      });
    }
  }

  loadPending().forEach(function (review, index) {
    addPendingCard(review, -1 - index);
  });

  function sorted() {
    var mode = sort ? sort.value : 'featured';
    return cards.slice().sort(function (a, b) {
      var ratingA = Number(a.getAttribute('data-rating') || 0);
      var ratingB = Number(b.getAttribute('data-rating') || 0);
      var dateA = parseDate(a.getAttribute('data-date'));
      var dateB = parseDate(b.getAttribute('data-date'));
      var orderA = Number(a.getAttribute('data-order') || 0);
      var orderB = Number(b.getAttribute('data-order') || 0);
      if (mode === 'newest') return dateB - dateA;
      if (mode === 'highest') return ratingB - ratingA || dateB - dateA;
      if (mode === 'lowest') return ratingA - ratingB || dateB - dateA;
      return orderA - orderB;
    });
  }

  function render() {
    if (!list) return;
    var items = sorted();
    var pages = Math.max(1, Math.ceil(items.length / pageSize));
    if (page > pages) page = pages;
    var start = (page - 1) * pageSize;
    var visible = items.slice(start, start + pageSize);
    cards.forEach(function (card) {
      card.hidden = true;
    });
    visible.forEach(function (card) {
      card.hidden = false;
      list.appendChild(card);
    });
    if (!pager) return;
    pager.innerHTML = '';
    if (pages <= 1) {
      pager.hidden = true;
      return;
    }
    pager.hidden = false;
    for (var i = 1; i <= pages; i++) {
      var button = document.createElement('button');
      button.type = 'button';
      button.textContent = String(i);
      if (i === page) button.className = 'is-active';
      button.setAttribute('data-page', String(i));
      pager.appendChild(button);
    }
  }

  function setRating(value) {
    if (!ratingInput || !stars) return;
    ratingInput.value = String(value);
    Array.prototype.forEach.call(stars.querySelectorAll('[data-star]'), function (button) {
      button.classList.toggle('is-on', Number(button.getAttribute('data-star')) <= value);
    });
  }

  function resizeImage(file) {
    return new Promise(function (resolve) {
      var reader = new FileReader();
      reader.onload = function () {
        var image = new Image();
        image.onload = function () {
          var max = 900;
          var scale = Math.min(1, max / Math.max(image.width, image.height));
          var canvas = document.createElement('canvas');
          canvas.width = Math.round(image.width * scale);
          canvas.height = Math.round(image.height * scale);
          canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height);
          resolve(canvas.toDataURL('image/jpeg', 0.72));
        };
        image.src = reader.result;
      };
      reader.readAsDataURL(file);
    });
  }

  function renderPreviews() {
    if (!previews) return;
    previews.innerHTML = '';
    chosenFiles.forEach(function (file) {
      var li = document.createElement('li');
      var img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.alt = file.name;
      li.appendChild(img);
      previews.appendChild(li);
    });
    if (photoCount) photoCount.value = String(chosenFiles.length);
    if (photoNames) photoNames.value = chosenFiles.map(function (file) { return file.name; }).join(', ');
    if (uploadCount) uploadCount.textContent = chosenFiles.length + '/5';
  }

  if (bodyInput && countEl) {
    bodyInput.addEventListener('input', function () {
      countEl.textContent = bodyInput.value.length + '/2000';
    });
  }

  if (openBtn && dialog) {
    openBtn.addEventListener('click', function () {
      if (typeof dialog.showModal === 'function') dialog.showModal();
    });
  }
  if (closeBtn && dialog) {
    closeBtn.addEventListener('click', function () {
      dialog.close();
    });
  }
  if (stars) {
    stars.addEventListener('click', function (event) {
      var button = event.target.closest('[data-star]');
      if (!button) return;
      setRating(Number(button.getAttribute('data-star')));
    });
  }
  if (fileInput) {
    fileInput.addEventListener('change', function () {
      var next = Array.prototype.slice.call(fileInput.files || [], 0, 5 - chosenFiles.length);
      chosenFiles = chosenFiles.concat(next).slice(0, 5);
      fileInput.value = '';
      renderPreviews();
    });
  }
  if (form) {
    form.addEventListener('submit', function (event) {
      if (!ratingInput || !ratingInput.value) {
        event.preventDefault();
        window.alert(ratingError);
        return;
      }
      event.preventDefault();
      var name = form.querySelector('[name="contact[name]"]').value.trim();
      var body = (bodyInput ? bodyInput.value : '').trim();
      var title = body.split(/[.!?]/)[0].slice(0, 70);
      if (titleInput) titleInput.value = title;
      var rating = Number(ratingInput.value);
      Promise.all(chosenFiles.map(resizeImage)).then(function (photoData) {
        var review = {
          name: name,
          title: title,
          body: body,
          rating: rating,
          date: new Date().toISOString().slice(0, 10),
          photos: photoData
        };
        var pending = loadPending();
        pending.unshift(review);
        savePending(pending.slice(0, 8));
        addPendingCard(review, 0);
        page = 1;
        render();
        form.querySelector('[name="contact[body]"]').value =
          'Store review (' + rating + '/5)\nTitle: ' + title + '\nPhotos: ' + chosenFiles.length +
          (photoNames && photoNames.value ? ' (' + photoNames.value + ')' : '') +
          '\n\n' + body;
        form.submit();
      });
    });
  }
  if (sort) {
    sort.addEventListener('change', function () {
      page = 1;
      render();
    });
  }
  if (pager) {
    pager.addEventListener('click', function (event) {
      var button = event.target.closest('button[data-page]');
      if (!button) return;
      page = Number(button.getAttribute('data-page') || 1);
      render();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  render();
})();
{% endjavascript %}


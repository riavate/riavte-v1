<section class="product-infusion">
  <div class="product-infusion__layout">
    <div class="product-infusion__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-infusion__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="product-infusion__heading">{{ section.settings.heading | escape }}</h2>
      <div class="product-infusion__text rte">{{ section.settings.text }}</div>
      <ol class="product-infusion__steps">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title | escape }}</strong>
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ol>
    </div>

    <div class="product-infusion__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 990px) 502px, 100vw', alt: section.settings.image.alt, class: 'product-infusion__image'
        }}
      {%- else -%}
        <img class="product-infusion__image" src="{{ 'product-how.jpg' | asset_url }}" alt="" width="502" height="502">
      {%- endif -%}
      {%- if section.settings.overlay != blank -%}
        <p class="product-infusion__overlay">{{ section.settings.overlay | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-infusion {
    padding: 4.5rem 0;
  }

  .product-infusion__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    width: min(1212px, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .product-infusion__eyebrow {
    margin: 0;
    color: #121a43;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .product-infusion__heading {
    margin: 0.6rem 0 0;
    max-width: 26rem;
    color: #121a43;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .product-infusion__heading {
      background-image: linear-gradient(90deg, #121a43, #2d42a9);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .product-infusion__text,
  .product-infusion__steps {
    max-width: 30rem;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }

  .product-infusion__text {
    margin: 1.1rem 0 0;
  }

  .product-infusion__steps {
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product-infusion__steps li {
    margin-top: 0.85rem;
  }

  .product-infusion__steps strong,
  .product-infusion__steps span {
    display: block;
  }

  .product-infusion__media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    min-height: 320px;
    aspect-ratio: 1;
    background: #d7dde8;
  }

  .product-infusion__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-infusion__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    color: #0037ae;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .product-infusion__layout {
      grid-template-columns: 1fr;
    }

    .product-infusion__heading,
    .product-infusion__overlay {
      font-size: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_infusion.name",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.product_infusion.settings.eyebrow", "default": "How micro-infusion works" },
    { "type": "text", "id": "heading", "label": "t:sections.product_infusion.settings.heading", "default": "Advanced Scalp Care, Precisely Delivered." },
    { "type": "richtext", "id": "text", "label": "t:sections.product_infusion.settings.text", "default": "<p>Riavâte’s 0.5 mm micro-infusion system creates controlled micro-channels across the scalp, allowing the GHK-Cu powered cosmetic formula to be applied precisely and evenly.</p><p>Designed to bring together precision technology and targeted scalp care in one considered system.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:sections.product_infusion.settings.image" },
    { "type": "textarea", "id": "overlay", "label": "t:sections.product_infusion.settings.overlay", "default": "How to\nWork video" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.product_infusion.blocks.step.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.product_infusion.blocks.step.title", "default": "01 — Micro-infuse" },
        { "type": "text", "id": "text", "label": "t:sections.product_infusion.blocks.step.text", "default": "0.5 mm precision application" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.product_infusion.name" }]
}
{% endschema %}

<section class="science-note">
  <div class="science-note__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="science-note__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="science-note__heading">{{ section.settings.heading | escape | replace: '. ', '.<br>' }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="science-note__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .science-note {
    color: #ffffff;
    background-image: linear-gradient(180deg, #020814 0%, #06307a 100%);
  }

  .science-note__inner {
    max-width: 40rem;
    margin: 0 auto;
    padding: 5.5rem 1.5rem;
    text-align: center;
  }

  .science-note__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .science-note__heading {
    margin: 0;
    font-size: clamp(1.85rem, 3.4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .science-note__text {
    margin-top: 1.2rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
  }

  .science-note__text p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.science_note.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.science_note.settings.eyebrow",
      "default": "A clear distinction"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.science_note.settings.heading",
      "default": "Understanding the evidence."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.science_note.settings.text",
      "default": "<p>Published research on an ingredient is not the same as a result from the finished Riavâte system. We share that context so the formula can be read clearly.</p>"
    }
  ],
  "presets": [
    { "name": "t:sections.science_note.name" }
  ]
}
{% endschema %}

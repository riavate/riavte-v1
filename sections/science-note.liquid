<section class="science-note">
  <div class="science-note__inner">
    <div class="science-note__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="science-note__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="science-note__heading">{{ section.settings.heading | escape | replace: ' the ', '<br>the ' }}</h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p class="science-note__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="science-note__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .science-note {
    color: #ffffff;
    background-image: linear-gradient(105deg, #000000 0%, #041433 46%, #0037ae 100%);
  }

  .science-note__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 5.75rem 1.5rem 5.75rem 16%;
  }

  .science-note__copy {
    max-width: 36rem;
    padding-left: 1.4rem;
    border-left: 1px solid rgba(255, 255, 255, 0.55);
  }

  .science-note__eyebrow {
    margin: 0 0 0.9rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: none;
    color: rgba(255, 255, 255, 0.78);
  }

  .science-note__heading {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.1rem, 4vw, 3.05rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .science-note__lede {
    margin: 1.15rem 0 0;
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.4;
  }

  .science-note__text {
    max-width: 34rem;
    margin-top: 1.15rem;
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
  }

  .science-note__text p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .science-note__inner {
      padding: 4rem 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.science_note.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.science_note.settings.eyebrow",
      "default": "A clear distinction"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.science_note.settings.heading",
      "default": "Understanding the evidence."
    },
    {
      "type": "text",
      "id": "lede",
      "label": "t:sections.science_note.settings.lede",
      "default": "Independent research Riavâte clinical results"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.science_note.settings.text",
      "default": "<p>Published research on an ingredient is not the same as a result from the finished Riavâte system. We share that context so the formula can be read clearly.</p>"
    }
  ],
  "presets": [
    { "name": "t:sections.science_note.name" }
  ]
}
{% endschema %}

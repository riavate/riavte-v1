<section class="product-results">
  <div class="product-results__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="product-results__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="product-results__heading">{{ section.settings.heading | escape }}</h2>
  </div>
  <ul class="product-results__grid">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <div class="product-results__pair">
          {%- if block.settings.before != blank -%}
            {{ block.settings.before | image_url: width: 600 | image_tag: alt: block.settings.title, class: 'product-results__image' }}
          {%- else -%}
            <img class="product-results__image" src="{{ block.settings.before_asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="167" height="168">
          {%- endif -%}
          {%- if block.settings.after != blank -%}
            {{ block.settings.after | image_url: width: 600 | image_tag: alt: block.settings.title, class: 'product-results__image' }}
          {%- else -%}
            <img class="product-results__image" src="{{ block.settings.after_asset | asset_url }}" alt="" width="167" height="168">
          {%- endif -%}
        </div>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .product-results {
    width: min(1212px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 4rem 0 1rem;
  }

  .product-results__eyebrow {
    margin: 0;
    color: #121a43;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .product-results__heading {
    margin: 0.45rem 0 0;
    max-width: 40rem;
    color: #121a43;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.2;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .product-results__heading {
      background-image: linear-gradient(90deg, #111 16%, #2d42a9 84%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .product-results__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product-results__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
  }

  .product-results__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
  }

  .product-results__pair img:first-child {
    object-position: 18% center;
  }

  .product-results__pair img:last-child {
    object-position: 82% center;
  }

  .product-results__grid h3 {
    margin: 0.8rem 0 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .product-results__grid p {
    margin: 0.2rem 0 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    .product-results__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_results.name",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.product_results.settings.eyebrow", "default": "Real routines. Visible progress." },
    { "type": "text", "id": "heading", "label": "t:sections.product_results.settings.heading", "default": "Results from the Riavâte Community" }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "t:sections.product_results.blocks.result.name",
      "settings": [
        { "type": "image_picker", "id": "before", "label": "t:sections.product_results.blocks.result.before" },
        { "type": "text", "id": "before_asset", "label": "t:sections.product_results.blocks.result.before_asset", "default": "product-result-1.jpg" },
        { "type": "image_picker", "id": "after", "label": "t:sections.product_results.blocks.result.after" },
        { "type": "text", "id": "after_asset", "label": "t:sections.product_results.blocks.result.after_asset", "default": "product-result-1.jpg" },
        { "type": "text", "id": "title", "label": "t:sections.product_results.blocks.result.title", "default": "Reduced shedding" },
        { "type": "textarea", "id": "text", "label": "t:sections.product_results.blocks.result.text", "default": "Hair appears stronger and more resilient with continued use." }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.product_results.name" }]
}
{% endschema %}

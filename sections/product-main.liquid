<section class="product-main">
  <div class="product-main__layout">
    <div class="product-main__media">
      <div class="product-gallery" data-gallery>
        <div class="product-gallery__thumbs">
          {%- if product != blank and product.images.size > 0 -%}
            {%- for image in product.images -%}
              <button
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-gallery-thumb
                data-src="{{ image | image_url: width: 1400 }}"
                aria-label="{{ image.alt | default: product.title | escape }}"
                {% if forloop.first %}
                  aria-current="true"
                {% endif %}
              >
                {{
                  image
                  | image_url: width: 200
                  | image_tag: widths: '100, 200', sizes: '100px', alt: '', class: 'product-gallery__thumb-image'
                }}
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- assign fallbacks = 'product-gallery-1.jpg,product-gallery-2.jpg,product-gallery-3.jpg,product-gallery-4.jpg,product-gallery-5.jpg' | split: ',' -%}
            {%- for file in fallbacks -%}
              <button
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-gallery-thumb
                data-src="{{ file | asset_url }}"
                {% if forloop.first %}
                  aria-current="true"
                {% endif %}
              >
                <img class="product-gallery__thumb-image" src="{{ file | asset_url }}" alt="" width="100" height="100">
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="product-gallery__stage">
          {%- if product != blank and product.featured_image != blank -%}
            <img
              class="product-gallery__image"
              data-gallery-image
              src="{{ product.featured_image | image_url: width: 1400 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {%- else -%}
            <img
              class="product-gallery__image"
              data-gallery-image
              src="{{ 'product-gallery-1.jpg' | asset_url }}"
              alt="{{ section.settings.heading | escape }}"
              width="536"
              height="536"
            >
          {%- endif -%}
        </div>
      </div>

      <div class="product-main__docs">
        <a class="product-main__doc" href="{{ section.settings.ingredients_link | default: '#' }}">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
            <path d="M6.4 1.8h5.2M7.1 1.8v3.1L4 12.6a2.1 2.1 0 0 0 1.9 3h6.2a2.1 2.1 0 0 0 1.9-3L10.9 4.9V1.8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
            <path d="M6.1 10.6h5.8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          <span>{{ section.settings.ingredients_label | escape }}</span>
        </a>
        <a class="product-main__doc" href="{{ section.settings.certificate_link | default: '#' }}">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
            <rect x="2.4" y="2" width="9" height="11" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <path d="M4.4 5h5M4.4 7.2h5M4.4 9.4h3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <circle cx="12.1" cy="12.2" r="2.15" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <path d="M11 14.1 10.4 16.2l1.7-.8 1.7.8L13.2 14" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
          </svg>
          <span>{{ section.settings.certificate_label | escape }}</span>
        </a>
      </div>

      <div class="product-main__accordions">
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <details class="product-main__accordion" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.title | escape }}</span>
              </summary>
              <div class="product-main__accordion-body rte">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="product-main__info">
      {%- if product != blank and product.title != blank -%}
        <h1 class="product-main__title">{{ product.title | escape }}</h1>
      {%- else -%}
        <h1 class="product-main__title">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {%- endif -%}

      <p class="product-main__rating">
        <span class="product-main__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg width="16" height="16" viewBox="0 0 16 16"><path fill="#2d42a9" d="M8 1.2 9.8 5.6l4.7.4-3.6 3.1 1.1 4.6L8 11.4 4 13.7l1.1-4.6L1.5 6l4.7-.4L8 1.2Z"/></svg>
          {%- endfor -%}
        </span>
        <span>{{ section.settings.rating | escape }}</span>
      </p>

      {%- if product != blank and product.description != blank -%}
        <div class="product-main__description rte">{{ product.description }}</div>
      {%- else -%}
        <p class="product-main__description">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <ul class="product-main__points">
        {%- for block in section.blocks -%}
          {%- if block.type == 'point' -%}
            <li {{ block.shopify_attributes }}>
              <img
                class="product-main__check"
                src="{{ 'product-point-badge.png' | asset_url }}"
                alt=""
                width="18"
                height="18"
                loading="lazy"
              >
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.guarantee_title != blank -%}
        <div class="product-main__guarantee">
          <svg class="product-main__guarantee-icon" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
            <circle cx="14" cy="14" r="14" fill="currentColor"/>
            <path d="M8.1 14.4 12 18.2 19.9 10.1" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>
            <span class="product-main__guarantee-title">{{ section.settings.guarantee_title | escape }}</span>
            {%- if section.settings.guarantee_text != blank -%}
              <span class="product-main__guarantee-text">{{ section.settings.guarantee_text | escape }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- if product != blank -%}
        {% form 'product', product, class: 'product-main__form' %}
          {%- assign current_variant = product.selected_or_first_available_variant -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- comment -%} Beez / other app blocks render purchase options and pricing. {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- endif -%}
          {%- endfor -%}

          <button class="product-main__submit" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}
              {{ 'products.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </button>
        {% endform %}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-main {
    padding: 2.4rem 0 1.5rem;
  }

  .product-main__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.6rem);
    width: min(1212px, calc(100% - 2.5rem));
    margin-inline: auto;
    align-items: start;
  }

  .product-gallery {
    --product-thumb: 78px;
    --product-thumb-gap: 0.7rem;
    display: grid;
    grid-template-columns: var(--product-thumb) minmax(0, 1fr);
    gap: var(--product-thumb-gap);
    align-items: start;
  }

  .product-gallery__thumbs {
    display: grid;
    gap: 0.55rem;
  }

  .product-gallery__thumb {
    width: var(--product-thumb);
    height: var(--product-thumb);
    padding: 0;
    border: 1px solid #e6e6e6;
    border-radius: 14px;
    overflow: hidden;
    background: #f6f6f6;
    cursor: pointer;
  }

  .product-gallery__thumb.is-active {
    border-color: #2f6df6;
  }

  .product-gallery__thumb-image,
  .product-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__stage {
    border: 2px solid #2f6df6;
    border-radius: 18px;
    overflow: hidden;
    background: #f7f7f7;
    aspect-ratio: 1;
  }

  .product-main__docs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    margin: 1rem 0 0 calc(var(--product-thumb, 78px) + var(--product-thumb-gap, 0.7rem));
  }

  .product-main__doc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    border: 1px solid #d5d5d5;
    border-radius: 16px;
    color: #1c1c1c;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
  }

  .product-main__doc svg {
    flex: 0 0 auto;
    color: #5c6570;
  }

  .product-main__accordions {
    margin-top: 0.35rem;
  }

  .product-main__accordion {
    border-top: 1px solid #e3e3e3;
    margin-left: calc(var(--product-thumb, 78px) + var(--product-thumb-gap, 0.7rem));
  }

  .product-main__accordion:last-child {
    border-bottom: 1px solid #e3e3e3;
  }

  .product-main__accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0;
    color: #161616;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .product-main__accordion summary::-webkit-details-marker {
    display: none;
  }

  .product-main__accordion:not([open]) > .product-main__accordion-body {
    display: none;
  }

  .product-main__accordion-body {
    padding: 0 1.5rem 0.9rem 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .product-main__title {
    margin: 0;
    max-width: none;
    color: #121a43;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.12;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .product-main__title {
      background-image: linear-gradient(90deg, #121a43, #2d42a9);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .product-main__rating {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.85rem 0 0;
    font-size: 14px;
    font-weight: 500;
  }

  .product-main__stars {
    display: inline-flex;
    gap: 2px;
  }

  .product-main__description {
    margin: 0.85rem 0 0;
    max-width: 32rem;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .product-main__points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem 1.35rem;
    margin: 1.05rem 0 0;
    padding: 0;
    list-style: none;
    color: #2a2a2a;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
  }

  .product-main__points li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .product-main__check {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    object-fit: contain;
  }

  .product-main__guarantee {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.15rem;
    padding: 0.8rem 1rem;
    border: 1.5px solid #8ed39a;
    border-radius: 16px;
    background: #fff;
  }

  .product-main__guarantee-icon {
    flex: 0 0 28px;
    color: #2f9d4a;
  }

  .product-main__guarantee-title,
  .product-main__guarantee-text {
    display: block;
  }

  .product-main__guarantee-title {
    color: #1a1a1a;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .product-main__guarantee-text {
    margin-top: 0.12rem;
    color: #6b7280;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
  }

  .product-main__supplies {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.95rem;
  }

  .supply-card {
    position: relative;
    display: block;
    padding: 0.85rem 1.05rem 0.8rem;
    border: 1px solid #d8d8d8;
    border-radius: 16px;
    background: #fff;
    cursor: pointer;
  }

  .supply-card:has(.supply-card__input:checked),
  .supply-card.is-selected:has(.supply-card__input:checked) {
    border-color: #c8c8c8;
    box-shadow: none;
  }

  .product-main__info #subscribee-widget {
    display: none !important;
  }

  .supply-card__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .supply-card__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .supply-card__title,
  .supply-card__subtitle,
  .supply-card__prices {
    display: block;
  }

  .supply-card__title {
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    text-transform: uppercase;
  }

  .supply-card__subtitle,
  .supply-card__details {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  .supply-card__prices {
    text-align: right;
    white-space: nowrap;
    font-size: 14px;
  }

  .supply-card__prices s {
    margin-right: 0.4rem;
    color: #8a8a8a;
    font-weight: 500;
    text-decoration: line-through;
  }

  .supply-card__prices strong {
    color: #111;
    font-weight: 700;
  }

  .supply-card__details {
    margin: 0.65rem 0 0;
    padding: 0.65rem 0 0 1.15rem;
    border-top: 1px solid #ececec;
    color: #222;
  }

  .supply-card__details li + li {
    margin-top: 0.15rem;
  }

  .supply-card:has(.supply-card__badge) {
    margin-bottom: 0.55rem;
  }

  .supply-card__badge {
    position: absolute;
    right: 1.1rem;
    bottom: -0.7rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #121a43, #2d42a9);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  .product-main__submit {
    width: 100%;
    margin-top: 1rem;
    min-height: 48px;
    border: 0;
    border-radius: 14px;
    background: linear-gradient(90deg, #121a43, #2d42a9);
    color: #fff;
    font-family: inherit;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .product-main__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  @media screen and (max-width: 989px) {
    .product-main__layout {
      grid-template-columns: 1fr;
    }

    .product-gallery {
      grid-template-columns: 1fr;
    }

    .product-gallery__thumbs {
      display: flex;
      order: 2;
      overflow-x: auto;
    }

    .product-gallery__thumb {
      flex: 0 0 84px;
      width: 84px;
      height: 84px;
    }

    .product-main__docs,
    .product-main__accordion {
      margin-left: 0;
    }
  }

  @media screen and (max-width: 549px) {
    .product-main__points,
    .product-main__docs {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const thumb = event.target.closest('[data-gallery-thumb]');
    if (!thumb) return;
    const gallery = thumb.closest('[data-gallery]');
    if (!gallery) return;
    const image = gallery.querySelector('[data-gallery-image]');
    const nextSrc = thumb.getAttribute('data-src');
    if (!image || !nextSrc) return;

    const picture = image.closest('picture');
    if (picture) {
      picture.querySelectorAll('source').forEach((source) => {
        source.remove();
      });
    }

    image.removeAttribute('srcset');
    image.removeAttribute('sizes');
    image.src = nextSrc;
    gallery.querySelectorAll('[data-gallery-thumb]').forEach((item) => {
      const active = item === thumb;
      item.classList.toggle('is-active', active);
      if (active) {
        item.setAttribute('aria-current', 'true');
      } else {
        item.removeAttribute('aria-current');
      }
    });
  });

{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product_main.name",
  "tag": "section",
  "class": "product-main-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.product_main.settings.heading",
      "default": "The Precision\nMicro-Infusion System for Advanced Scalp Care"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.product_main.settings.text",
      "default": "A precision-led scalp-care system combining controlled 0.5 mm micro-infusion with Cuprofuse®, our concentrated serum led by GHK-Cu and a precisely configured combination of targeted scalp-care ingredients."
    },
    {
      "type": "text",
      "id": "rating",
      "label": "t:sections.product_main.settings.rating",
      "default": "4.80 out of 5"
    },
    {
      "type": "text",
      "id": "guarantee_title",
      "label": "t:sections.product_main.settings.guarantee_title",
      "default": "90-Day Money-Back Guarantee"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "t:sections.product_main.settings.guarantee_text",
      "default": "Shop with confidence"
    },
    {
      "type": "text",
      "id": "ingredients_label",
      "label": "t:sections.product_main.settings.ingredients_label",
      "default": "Ingredients"
    },
    {
      "type": "url",
      "id": "ingredients_link",
      "label": "t:sections.product_main.settings.ingredients_link"
    },
    {
      "type": "text",
      "id": "certificate_label",
      "label": "t:sections.product_main.settings.certificate_label",
      "default": "Lab Certificate"
    },
    {
      "type": "url",
      "id": "certificate_link",
      "label": "t:sections.product_main.settings.certificate_link"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "point",
      "name": "t:sections.product_main.blocks.point.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.product_main.blocks.point.text",
          "default": "0.5 mm precision micro-infusion"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "t:sections.product_main.blocks.accordion.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.product_main.blocks.accordion.title",
          "default": "Key benefits"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.product_main.blocks.accordion.content",
          "default": "<p>Hair appears stronger and more resilient with continued use.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_main.name"
    }
  ]
}
{% endschema %}

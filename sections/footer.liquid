<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 480
            | image_tag:
              widths: '180, 280, 420',
              sizes: '212px',
              alt: shop.name,
              class: 'site-footer__logo-image'
          }}
        {%- else -%}
          <img
            class="site-footer__logo-image"
            src="{{ 'logo-white.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="212"
            height="37"
          >
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="site-footer__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="site-footer__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.phone != blank or section.settings.email != blank -%}
        <p class="site-footer__contact-label">{{ section.settings.contact_heading | escape }}</p>
        {%- if section.settings.phone != blank -%}
          <a class="site-footer__contact" href="tel:{{ section.settings.phone | remove: ' ' }}">
            {{ 'footer.call' | t: phone: section.settings.phone }}
          </a>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <a class="site-footer__contact" href="mailto:{{ section.settings.email }}">
            {{ 'footer.email' | t: email: section.settings.email }}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="site-footer__column" {{ block.shopify_attributes }}>
        <p class="site-footer__heading">{{ block.settings.heading | escape }}</p>
        <ul class="site-footer__links">
          {%- assign rows = block.settings.links | newline_to_br | split: '<br />' -%}
          {%- for row in rows -%}
            {%- assign item = row | strip -%}
            {%- if item != blank -%}
              {%- assign parts = item | split: '|' -%}
              {%- assign label = parts | first | strip -%}
              {%- if parts.size > 1 -%}
                {%- assign href = parts | last | strip -%}
              {%- else -%}
                {%- assign href = routes.root_url -%}
              {%- endif -%}
              <li>
                <a href="{{ href }}">{{ label | escape }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  <div class="site-footer__social">
    {%- if section.settings.instagram != blank -%}
      <a href="{{ section.settings.instagram }}" aria-label="{{ 'footer.instagram' | t }}">
        <img src="{{ 'social-instagram.png' | asset_url }}" alt="" width="35" height="35">
      </a>
    {%- endif -%}
    {%- if section.settings.facebook != blank -%}
      <a href="{{ section.settings.facebook }}" aria-label="{{ 'footer.facebook' | t }}">
        <img src="{{ 'social-facebook.png' | asset_url }}" alt="" width="35" height="35">
      </a>
    {%- endif -%}
    {%- if section.settings.tiktok != blank -%}
      <a href="{{ section.settings.tiktok }}" aria-label="{{ 'footer.tiktok' | t }}">
        <img src="{{ 'social-tiktok.png' | asset_url }}" alt="" width="31" height="31">
      </a>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    display: flex;
    flex-direction: column;
    margin-top: 0;
    color: #ffffff;
    background-image: linear-gradient(124deg, #000000 11%, #0037ae 87%);
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(220px, 1.4fr) repeat(3, minmax(140px, 1fr));
    gap: 2.5rem 2rem;
    width: min(1120px, calc(100% - 2.5rem));
    margin-inline: auto;
    padding: 4.5rem 0 1.5rem;
  }

  .site-footer__logo-image {
    width: auto;
    height: 37px;
    max-width: 212px;
  }

  .site-footer__tagline {
    margin: 1.4rem 0 0;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.4;
  }

  .site-footer__text {
    max-width: 20rem;
    margin: 0.85rem 0 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
  }

  .site-footer__contact-label {
    margin: 1.6rem 0 0.45rem;
    font-size: 15px;
    font-weight: 800;
  }

  .site-footer__contact {
    display: block;
    margin-top: 0.35rem;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
  }

  .site-footer__heading {
    margin: 0 0 0.9rem;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .site-footer__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-block;
    padding: 0.35rem 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    text-transform: capitalize;
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible,
  .site-footer__contact:hover,
  .site-footer__contact:focus-visible {
    text-decoration: underline;
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: min(1120px, calc(100% - 2.5rem));
    margin-inline: auto;
    padding: 0 0 3rem;
  }

  .site-footer__social img {
    width: 35px;
    height: 35px;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      padding-top: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.footer.settings.logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:sections.footer.settings.tagline",
      "default": "Precision science. Visible confidence."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.footer.settings.text",
      "default": "Science-led scalp care, thoughtfully formulated with GHK-Cu and selected cosmetic actives."
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "t:sections.footer.settings.contact_heading",
      "default": "Contact information"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.footer.settings.phone",
      "default": "+86 18560628679"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.footer.settings.email",
      "default": "info@gasoplus.co.uk"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "t:sections.footer.settings.instagram"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "t:sections.footer.settings.facebook"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "t:sections.footer.settings.tiktok"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.footer.blocks.column.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.column.heading",
          "default": "Explore"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "t:sections.footer.blocks.column.links",
          "info": "t:sections.footer.blocks.column.links_info",
          "default": "The Kit|/products/the-kit\nThe Science|/\nOur Formula|/\nHow to Use|/\nAbout Riavâte|/"
        }
      ]
    }
  ]
}
{% endschema %}

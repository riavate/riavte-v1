<section class="product-steps">
  <div class="product-steps__intro">
    <p class="product-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="product-steps__heading">{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="product-steps__layout">
    <div class="product-steps__video">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag: alt: '', class: 'product-steps__video-image' }}
      {%- endif -%}
      <p>{{ section.settings.video_label | escape | newline_to_br }}</p>
    </div>
    <ol class="product-steps__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: alt: block.settings.title, class: 'product-steps__image' }}
          {%- else -%}
            <img class="product-steps__image" src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" width="221" height="222">
          {%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .product-steps {
    width: min(1212px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 3.5rem 0 2rem;
  }

  .product-steps__eyebrow {
    margin: 0;
    color: #121a43;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .product-steps__heading {
    margin: 0.4rem 0 0;
    color: #121a43;
    font-size: 32px;
    font-weight: 800;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .product-steps__heading {
      background-image: linear-gradient(90deg, #111 16%, #2d42a9 84%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .product-steps__layout {
    display: grid;
    grid-template-columns: 318px minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 1.4rem;
    align-items: start;
  }

  .product-steps__video {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
    border-radius: 16px;
    background: #d3d3d3;
    overflow: hidden;
  }

  .product-steps__video-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-steps__video p {
    position: relative;
    margin: 0;
    color: #fff;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
  }

  .product-steps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-steps__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
  }

  .product-steps__list h3 {
    margin: 0.75rem 0 0;
    font-size: 14px;
    font-weight: 700;
  }

  .product-steps__list p {
    margin: 0.25rem 0 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    .product-steps__layout,
    .product-steps__list {
      grid-template-columns: 1fr;
    }

    .product-steps__video {
      min-height: 240px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_steps.name",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.product_steps.settings.eyebrow", "default": "Real routines. Visible progress." },
    { "type": "text", "id": "heading", "label": "t:sections.product_steps.settings.heading", "default": "See How Simple It Is to Use" },
    { "type": "image_picker", "id": "image", "label": "t:sections.product_steps.settings.image" },
    { "type": "textarea", "id": "video_label", "label": "t:sections.product_steps.settings.video_label", "default": "How to\nuse video" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.product_steps.blocks.step.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.product_steps.blocks.step.image" },
        { "type": "text", "id": "fallback", "label": "t:sections.product_steps.blocks.step.fallback", "default": "product-step-1.jpg" },
        { "type": "text", "id": "title", "label": "t:sections.product_steps.blocks.step.title", "default": "01 — Prepare" },
        { "type": "textarea", "id": "text", "label": "t:sections.product_steps.blocks.step.text", "default": "Start with a clean, dry scalp." }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.product_steps.name" }]
}
{% endschema %}

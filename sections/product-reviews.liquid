<section class="product-reviews">
  <div class="product-reviews__summary">
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="product-reviews__top">
      <div>
        <p class="product-reviews__score">
          <span class="product-reviews__stars" aria-hidden="true">★★★★★</span>
          {{ section.settings.score | escape }}
        </p>
        <p class="product-reviews__count">{{ section.settings.count_label | escape }}</p>
        <p class="product-reviews__badge">{{ section.settings.badge | escape }}</p>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="product-reviews__write" href="{{ section.settings.button_link | default: '#' }}">
          <span class="product-reviews__write-label">{{ section.settings.button_label | escape }}</span>
        </a>
      {%- endif -%}
    </div>
    <div class="product-reviews__gallery">
      <ul class="product-reviews__thumbs">
        {%- for i in (1..8) -%}
          {%- liquid
            assign is_last = false
            if forloop.last
              assign is_last = true
            endif
          -%}
          <li class="product-reviews__thumb-item{% if is_last %} product-reviews__thumb-item--last{% endif %}">
            {%- if is_last and section.settings.more_label != blank -%}
              <a
                class="product-reviews__more-card"
                href="{{ section.settings.more_link | default: routes.root_url }}"
              >
                <span class="product-reviews__more-media">
                  <img
                    class="product-reviews__thumb"
                    src="{{ 'product-review-thumb.jpg' | asset_url }}"
                    alt=""
                    width="86"
                    height="83"
                    loading="lazy"
                  >
                </span>
                <span class="product-reviews__more-label">{{ section.settings.more_label | escape }}</span>
              </a>
            {%- else -%}
              <img
                class="product-reviews__thumb"
                src="{{ 'product-review-thumb.jpg' | asset_url }}"
                alt=""
                width="86"
                height="83"
                loading="lazy"
              >
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="product-reviews__list-head">
    <h3>{{ section.settings.list_heading | escape }}</h3>
  </div>
  <ul class="product-reviews__list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 700 | image_tag: alt: block.settings.name, class: 'product-reviews__photo' }}
        {%- else -%}
          <img class="product-reviews__photo" src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.name | escape }}" width="266" height="220">
        {%- endif -%}
        <div class="product-reviews__body">
          <p class="product-reviews__stars" aria-hidden="true">★★★★★</p>
          <p class="product-reviews__name">{{ block.settings.name | escape }}</p>
          <div class="rte">{{ block.settings.quote }}</div>
          <p class="product-reviews__date">{{ block.settings.date | escape }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ul>
  {%- if section.settings.more_button != blank -%}
    <p class="product-reviews__more">
      <a class="product-reviews__more-btn" href="{{ section.settings.more_link | default: '#' }}">
        <span class="product-reviews__more-btn-label">{{ section.settings.more_button | escape }}</span>
      </a>
    </p>
  {%- endif -%}
</section>

{% stylesheet %}
  .product-reviews {
    width: min(1212px, calc(100% - 2.5rem));
    margin: 2rem auto 4rem;
  }

  .product-reviews__summary {
    padding: 2rem 1.5rem 1.4rem;
    border-radius: 16px;
    background: #fff;
    box-shadow: 4px 7px 16px rgba(0, 0, 0, 0.12);
  }

  .product-reviews__summary h2,
  .product-reviews__list-head h3 {
    margin: 0;
    color: #121a43;
    text-align: center;
    font-size: 32px;
    font-weight: 700;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .product-reviews__summary h2 {
      background-image: linear-gradient(90deg, #121a43, #2d42a9);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .product-reviews__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .product-reviews__score,
  .product-reviews__count,
  .product-reviews__badge {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
  }

  .product-reviews__stars {
    color: #2d42a9;
    letter-spacing: 0.08em;
  }

  .product-reviews__badge {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 0.15rem 0.45rem;
    border-radius: 5px;
    background: #c3f6bd;
    font-size: 12px;
  }

  .product-reviews__write {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 221px;
    max-width: 100%;
    height: 43px;
    padding: 0 1rem;
    border: 1px solid transparent;
    border-radius: 15px;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(90deg, #121a43 0%, #2d42a9 100%) border-box;
    text-decoration: none;
  }

  .product-reviews__write-label {
    background-image: linear-gradient(90deg, #121a43 0%, #2d42a9 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
  }

  .product-reviews__gallery {
    margin: 1.1rem 0 0;
  }

  .product-reviews__thumbs {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr)) minmax(120px, 1.35fr);
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-reviews__thumb-item {
    min-width: 0;
  }

  .product-reviews__thumb {
    display: block;
    width: 100%;
    height: 81px;
    border-radius: 16px;
    object-fit: cover;
  }

  .product-reviews__more-card {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    height: 100%;
    color: #4a4a4a;
    text-decoration: none;
  }

  .product-reviews__more-media {
    position: relative;
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
  }

  .product-reviews__more-media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgba(0, 0, 0, 0.45);
  }

  .product-reviews__more-media .product-reviews__thumb {
    width: 100%;
  }

  .product-reviews__more-label {
    flex: 0 0 auto;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    color: #4a4a4a;
  }

  .product-reviews__list-head {
    margin-top: 2rem;
    padding-bottom: 0.8rem;
    border-bottom: 0.5px solid #111;
    text-align: left;
  }

  .product-reviews__list-head h3 {
    color: #111;
    font-size: 16px;
    text-align: left;
  }

  .product-reviews__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product-reviews__list li {
    border: 1px solid #111;
    border-radius: 16px;
    overflow: hidden;
  }

  .product-reviews__photo {
    width: 100%;
    aspect-ratio: 1.15;
    object-fit: cover;
  }

  .product-reviews__body {
    padding: 0.75rem 0.8rem 0.9rem;
    font-size: 12px;
  }

  .product-reviews__name {
    margin: 0.25rem 0;
    font-size: 12px;
    font-weight: 700;
  }

  .product-reviews__body .rte {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
  }

  .product-reviews__date {
    margin: 0.55rem 0 0;
    color: #8e8e8e;
    font-size: 11px;
    text-align: right;
  }

  .product-reviews__more {
    margin: 1.4rem 0 0;
    text-align: center;
  }

  .product-reviews__more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 224px;
    max-width: 100%;
    height: 44px;
    padding: 0 1.25rem;
    border: 1px solid transparent;
    border-radius: 22px;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(90deg, #121a43 0%, #2d42a9 100%) border-box;
    text-decoration: none;
  }

  .product-reviews__more-btn-label {
    background-image: linear-gradient(90deg, #121a43 0%, #2d42a9 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  @media screen and (max-width: 989px) {
    .product-reviews__thumbs {
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(110px, 1.2fr);
    }

    .product-reviews__thumb-item:nth-child(n + 5):not(.product-reviews__thumb-item--last) {
      display: none;
    }

    .product-reviews__list {
      grid-template-columns: 1fr 1fr;
    }

    .product-reviews__top {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media screen and (max-width: 549px) {
    .product-reviews__list {
      grid-template-columns: 1fr;
    }

    .product-reviews__thumbs {
      grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(100px, 1.15fr);
    }

    .product-reviews__thumb-item:nth-child(n + 4):not(.product-reviews__thumb-item--last) {
      display: none;
    }

    .product-reviews__thumb {
      height: 72px;
      border-radius: 12px;
    }

    .product-reviews__more-media {
      border-radius: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_reviews.name",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.product_reviews.settings.heading", "default": "Customer Reviews" },
    { "type": "text", "id": "score", "label": "t:sections.product_reviews.settings.score", "default": "4.80 out of 5" },
    { "type": "text", "id": "count_label", "label": "t:sections.product_reviews.settings.count_label", "default": "Based on 10457 reviews" },
    { "type": "text", "id": "badge", "label": "t:sections.product_reviews.settings.badge", "default": "✓ Verified Customer" },
    { "type": "text", "id": "button_label", "label": "t:sections.product_reviews.settings.button_label", "default": "Write a review" },
    { "type": "url", "id": "button_link", "label": "t:sections.product_reviews.settings.button_link" },
    { "type": "text", "id": "more_label", "label": "t:sections.product_reviews.settings.more_label", "default": "See more" },
    { "type": "text", "id": "list_heading", "label": "t:sections.product_reviews.settings.list_heading", "default": "Reviews 10457" },
    { "type": "text", "id": "more_button", "label": "t:sections.product_reviews.settings.more_button", "default": "Show more reviews" },
    { "type": "url", "id": "more_link", "label": "t:sections.product_reviews.settings.more_link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.product_reviews.blocks.review.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.product_reviews.blocks.review.image" },
        { "type": "text", "id": "fallback", "label": "t:sections.product_reviews.blocks.review.fallback", "default": "product-review-1.jpg" },
        { "type": "text", "id": "name", "label": "t:sections.product_reviews.blocks.review.name_label", "default": "James R." },
        { "type": "text", "id": "date", "label": "t:sections.product_reviews.blocks.review.date", "default": "18 September 2026" },
        { "type": "richtext", "id": "quote", "label": "t:sections.product_reviews.blocks.review.quote", "default": "<p>“Really easy to add to my routine.” The kit feels premium and straightforward to use.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.product_reviews.name" }]
}
{% endschema %}

<section class="science-explore">
  <div class="science-explore__inner">
    <div class="science-explore__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="science-explore__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="science-explore__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    <ul class="science-explore__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="science-explore__card" href="{{ block.settings.link }}">
          {%- else -%}
            <div class="science-explore__card">
          {%- endif -%}
            <p class="science-explore__index">0{{ forloop.index }}</p>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .science-explore {
    background: #ffffff;
    color: #121a43;
  }

  .science-explore__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 4.75rem 1.5rem 4.25rem;
  }

  .science-explore__intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid #1a1a1a;
  }

  .science-explore__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8b93a7;
  }

  .science-explore__heading {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .science-explore__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .science-explore__card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 1.35rem 1.15rem 1.4rem;
    border: 1px solid #e4e7ee;
    border-radius: 1rem;
    color: inherit;
    text-decoration: none;
  }

  a.science-explore__card:hover,
  a.science-explore__card:focus-visible {
    border-color: #0037ae;
  }

  .science-explore__index {
    margin: 0 0 1.4rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #c5cedb;
  }

  .science-explore__card h3 {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .science-explore__card p {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.5;
    color: #5c6578;
  }

  @media screen and (max-width: 989px) {
    .science-explore__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .science-explore__intro {
      flex-direction: column;
      align-items: flex-start;
    }

    .science-explore__list {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.science_explore.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.science_explore.settings.eyebrow",
      "default": "On this page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.science_explore.settings.heading",
      "default": "Explore the science"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.science_explore.blocks.card.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.science_explore.blocks.card.title",
          "default": "The device"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.science_explore.blocks.card.text",
          "default": "0.5 mm micro-infusion."
        },
        {
          "type": "text",
          "id": "link",
          "label": "t:sections.science_explore.blocks.card.link",
          "default": "#device"
        }
      ]
    }
  ],
  "presets": [
    { "name": "t:sections.science_explore.name" }
  ]
}
{% endschema %}

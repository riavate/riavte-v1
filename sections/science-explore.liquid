{%- liquid
  assign heading_html = section.settings.heading | escape
  if section.settings.italic_word != blank
    assign italic = section.settings.italic_word | escape
    assign needle = ' ' | append: italic | append: '.'
    assign wrapped = '<br><em>' | append: italic | append: '.</em>'
    assign heading_html = heading_html | replace: needle, wrapped
  endif
-%}

<section class="science-explore">
  <div class="science-explore__inner">
    <div class="science-explore__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="science-explore__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="science-explore__heading">{{ heading_html }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="science-explore__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <ul class="science-explore__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign index_label = forloop.index
          if forloop.index < 10
            assign index_label = '0' | append: forloop.index
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <details class="science-explore__row">
            <summary>
              <span class="science-explore__index">{{ index_label }}</span>
              {%- if block.settings.kicker != blank -%}
                <span class="science-explore__kicker">{{ block.settings.kicker | escape }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <span class="science-explore__title">{{ block.settings.title | escape }}</span>
              {%- endif -%}
              <span class="science-explore__plus" aria-hidden="true"></span>
            </summary>
            {%- if block.settings.text != blank -%}
              <div class="science-explore__panel">
                <p>{{ block.settings.text | escape }}</p>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ 'sections.science_explore.view_study' | t }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </details>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .science-explore {
    background: #ffffff;
    color: #1a2f7a;
  }

  .science-explore__inner {
    display: grid;
    grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.35fr);
    gap: 4rem;
    align-items: start;
    max-width: 1120px;
    margin: 0 auto;
    padding: 5.5rem 1.5rem;
  }

  .science-explore__eyebrow {
    margin: 0 0 1rem;
    color: #8b93a7;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: none;
  }

  .science-explore__heading {
    margin: 0;
    max-width: 12ch;
    color: #1a2f7a;
    font-size: clamp(2rem, 3.2vw, 2.7rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .science-explore__heading em {
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .science-explore__text {
    max-width: 16rem;
    margin: 1.15rem 0 0;
    color: #3a4258;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .science-explore__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .science-explore__row {
    border-top: 1px solid #e3e7ee;
  }

  .science-explore__list li:last-child .science-explore__row {
    border-bottom: 1px solid #e3e7ee;
  }

  .science-explore__row summary {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 1rem;
    grid-template-areas:
      "index kicker plus"
      "index title plus";
    column-gap: 0.85rem;
    align-items: center;
    padding: 1.15rem 0.15rem;
    cursor: pointer;
    list-style: none;
  }

  .science-explore__row summary::-webkit-details-marker {
    display: none;
  }

  .science-explore__index {
    grid-area: index;
    align-self: start;
    margin-top: 0.1rem;
    color: #c5cedb;
    font-size: 0.72rem;
    font-weight: 500;
  }

  .science-explore__kicker {
    grid-area: kicker;
    color: #8b93a7;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .science-explore__title {
    grid-area: title;
    margin-top: 0.35rem;
    color: #2f4bdb;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .science-explore__plus {
    grid-area: plus;
    position: relative;
    width: 14px;
    height: 14px;
  }

  .science-explore__plus::before,
  .science-explore__plus::after {
    content: "";
    position: absolute;
    background: #9aa3b5;
  }

  .science-explore__plus::before {
    top: 6px;
    left: 0;
    width: 14px;
    height: 1px;
  }

  .science-explore__plus::after {
    top: 0;
    left: 6px;
    width: 1px;
    height: 14px;
  }

  .science-explore__row[open] .science-explore__plus::after {
    display: none;
  }

  .science-explore__panel {
    max-width: 36rem;
    padding: 0 0 1.15rem 2.85rem;
    color: #3a4258;
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.55;
  }

  .science-explore__panel p {
    margin: 0;
  }

  .science-explore__panel a {
    display: inline-block;
    margin-top: 0.65rem;
    color: #2f4bdb;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .science-explore__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.science_explore.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.science_explore.settings.eyebrow",
      "default": "Scientific References"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.science_explore.settings.heading",
      "default": "Explore the research."
    },
    {
      "type": "text",
      "id": "italic_word",
      "label": "t:sections.science_explore.settings.italic_word",
      "default": "research"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.science_explore.settings.text",
      "default": "Independent research informing the science behind our approach."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.science_explore.blocks.card.name",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.science_explore.blocks.card.kicker",
          "default": "Microneedling"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.science_explore.blocks.card.title",
          "default": "Microneedling and hair-growth research"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.science_explore.blocks.card.text",
          "default": "Published research used as background for this topic. It is not a clinical result for Riavâte."
        },
        {
          "type": "text",
          "id": "link",
          "label": "t:sections.science_explore.blocks.card.link"
        }
      ]
    }
  ],
  "presets": [
    { "name": "t:sections.science_explore.name" }
  ]
}
{% endschema %}

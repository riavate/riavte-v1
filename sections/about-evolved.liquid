<section class="about-evolved">
  <div class="about-evolved__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '800, 1400, 2000',
          sizes: '100vw',
          alt: '',
          class: 'about-evolved__image'
      }}
    {%- else -%}
      <img class="about-evolved__image" src="{{ 'about-evolved.jpg' | asset_url }}" alt="" width="1024" height="534">
    {%- endif -%}
  </div>
  <div class="about-evolved__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="about-evolved__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="about-evolved__heading">{{ section.settings.heading | escape | replace: ' has ', '<br>has ' }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="about-evolved__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.points != blank -%}
      <ul class="about-evolved__points">
        {%- assign points = section.settings.points | newline_to_br | split: '<br />' -%}
        {%- for point in points -%}
          {%- assign item = point | strip -%}
          {%- if item != blank -%}
            <li>{{ item | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="about-evolved__button" href="{{ section.settings.button_link | default: '/products/the-kit' }}">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .about-evolved {
    position: relative;
    overflow: hidden;
    color: #ffffff;
    background: #041433;
  }

  .about-evolved__media {
    position: absolute;
    inset: 0;
  }

  .about-evolved__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .about-evolved__copy {
    position: relative;
    z-index: 1;
    width: min(34rem, calc(100% - 3rem));
    margin: 0 8% 0 auto;
    padding: 5.5rem 0;
    text-align: center;
  }

  .about-evolved__eyebrow {
    margin: 0 0 1.1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .about-evolved__heading {
    margin: 0;
    font-size: clamp(2.1rem, 4.2vw, 3.35rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: #3b82f6;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .about-evolved__text {
    max-width: 22rem;
    margin: 1.4rem auto 0;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
  }

  .about-evolved__text p {
    margin: 0;
  }

  .about-evolved__points {
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 2;
    text-transform: uppercase;
  }

  .about-evolved__button {
    display: inline-flex;
    align-items: center;
    margin-top: 1.75rem;
    padding: 0.85rem 1.45rem;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .about-evolved__copy {
      z-index: 2;
      margin: 0 auto;
      padding: 4.5rem 0;
    }

    .about-evolved::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: rgba(2, 12, 40, 0.45);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_evolved.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.about_evolved.settings.eyebrow",
      "default": "This is Riavâte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about_evolved.settings.heading",
      "default": "Scalp care has evolved."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.about_evolved.settings.text",
      "default": "<p>We believe better scalp care starts with precision — not complexity.</p>"
    },
    {
      "type": "textarea",
      "id": "points",
      "label": "t:sections.about_evolved.settings.points",
      "default": "Precision micro-infusion\nCuprofuse® concentrated serum\nGHK-Cu led formulation\nA system designed with purpose"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.about_evolved.settings.button_label",
      "default": "Shop the system →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.about_evolved.settings.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.about_evolved.settings.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.about_evolved.settings.image_alt",
      "default": "Riavâte device and serum"
    }
  ],
  "presets": [{ "name": "t:sections.about_evolved.name" }]
}
{% endschema %}

<section class="about-evolved">
  <div class="about-evolved__inner">
    <div class="about-evolved__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '600, 1000, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.image_alt,
            class: 'about-evolved__image'
        }}
      {%- else -%}
        <img
          class="about-evolved__image"
          src="{{ 'about-evolved.jpg' | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="1024"
          height="534"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    <div class="about-evolved__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about-evolved__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-evolved__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="about-evolved__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="about-evolved__button" href="{{ section.settings.button_link | default: '/products/the-kit' }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .about-evolved {
    color: #ffffff;
    background: #05070f;
  }

  .about-evolved__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
  }

  .about-evolved__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
    object-position: left center;
  }

  .about-evolved__copy {
    padding: 4rem 3rem 4rem 2.5rem;
  }

  .about-evolved__eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .about-evolved__heading {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .about-evolved__text {
    max-width: 28rem;
    margin-top: 1.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
  }

  .about-evolved__text p {
    margin: 0 0 0.75rem;
  }

  .about-evolved__button {
    display: inline-flex;
    align-items: center;
    margin-top: 1.75rem;
    padding: 0.9rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .about-evolved__inner {
      grid-template-columns: 1fr;
    }

    .about-evolved__image {
      min-height: 280px;
      max-height: 420px;
    }

    .about-evolved__copy {
      padding: 2.5rem 1.25rem 3.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_evolved.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.about_evolved.settings.eyebrow",
      "default": "Riavâte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about_evolved.settings.heading",
      "default": "Scalp care has evolved."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.about_evolved.settings.text",
      "default": "<p>Riavâte combines a precision micro-infusion device with Cuprofuse® so targeted scalp care can happen at home, in one considered routine.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.about_evolved.settings.button_label",
      "default": "Discover the kit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.about_evolved.settings.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.about_evolved.settings.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.about_evolved.settings.image_alt",
      "default": "Riavâte device and serum"
    }
  ],
  "presets": [{ "name": "t:sections.about_evolved.name" }]
}
{% endschema %}

<section class="info-page info-page--{{ section.settings.layout }}">
  <div class="info-page__inner">
    <header class="info-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="info-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="info-page__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.updated != blank -%}
        <p class="info-page__updated">{{ section.settings.updated | escape }}</p>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="info-page__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.layout == 'track' -%}
      <div class="info-page__form-card">
        {%- if section.settings.form_heading != blank -%}
          <h2>{{ section.settings.form_heading | escape }}</h2>
        {%- endif -%}
        {% form 'contact', class: 'info-page__form' %}
          {%- if form.posted_successfully? -%}
            <p class="info-page__success">{{ 'info_page.track_success' | t }}</p>
          {%- endif -%}
          {{ form.errors | default_errors }}
          <label>
            <span>{{ 'info_page.order' | t }}</span>
            <input type="text" name="contact[order number]" placeholder="{{ 'info_page.order_placeholder' | t }}" required>
          </label>
          <label>
            <span>{{ 'info_page.email' | t }}</span>
            <input type="email" name="contact[email]" placeholder="{{ 'info_page.email_placeholder' | t }}" autocomplete="email" required>
          </label>
          <input type="hidden" name="contact[body]" value="Please send the latest delivery status for this order.">
          <button type="submit">{{ 'info_page.track' | t }}</button>
        {% endform %}
      </div>
    {%- endif -%}

    {%- if section.settings.layout == 'faq' -%}
      <div class="info-page__faqs">
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' -%}
            <details class="info-page__faq" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}</summary>
              <div class="rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.layout == 'article' or section.settings.layout == 'contact' or section.settings.layout == 'track' -%}
      <div class="info-page__panels">
        {%- for block in section.blocks -%}
          {%- if block.type == 'panel' -%}
            <article class="info-page__panel" {{ block.shopify_attributes }}>
              {%- if block.settings.kicker != blank -%}
                <p>{{ block.settings.kicker | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h2>{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.layout == 'contact' -%}
      <div class="info-page__form-card">
        {%- if section.settings.form_heading != blank -%}
          <h2>{{ section.settings.form_heading | escape }}</h2>
        {%- endif -%}
        {% form 'contact', class: 'info-page__form' %}
          {%- if form.posted_successfully? -%}
            <p class="info-page__success">{{ 'info_page.success' | t }}</p>
          {%- endif -%}
          {{ form.errors | default_errors }}
          <label>
            <span>{{ 'info_page.name' | t }}</span>
            <input type="text" name="contact[name]" autocomplete="name" required>
          </label>
          <label>
            <span>{{ 'info_page.email' | t }}</span>
            <input type="email" name="contact[email]" autocomplete="email" required>
          </label>
          <label>
            <span>{{ 'info_page.order_optional' | t }}</span>
            <input type="text" name="contact[order number]">
          </label>
          <label>
            <span>{{ 'info_page.subject' | t }}</span>
            <input type="text" name="contact[subject]">
          </label>
          <label>
            <span>{{ 'info_page.message' | t }}</span>
            <textarea name="contact[body]" rows="6" required></textarea>
          </label>
          <button type="submit">{{ 'info_page.send' | t }}</button>
        {% endform %}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="info-page__note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .info-page {
    padding: 4.5rem 1.5rem 6rem;
    background: #f6f7fa;
    color: #121a43;
  }

  .info-page__inner {
    width: min(920px, 100%);
    margin: 0 auto;
  }

  .info-page__eyebrow {
    margin: 0 0 0.7rem;
    color: #8b93a7;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .info-page__heading {
    margin: 0;
    max-width: 12em;
    background: linear-gradient(90deg, #121a43, #2d42a9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(2.1rem, 4.4vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .info-page__updated {
    margin: 1rem 0 0;
    color: #8b93a7;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .info-page__intro {
    max-width: 42rem;
    margin-top: 1.25rem;
    color: #3a3a3a;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.65;
  }

  .info-page__intro p {
    margin: 0 0 0.8rem;
  }

  .info-page__faqs,
  .info-page__panels,
  .info-page__form-card {
    margin-top: 2.25rem;
  }

  .info-page__faq,
  .info-page__panel,
  .info-page__form-card {
    border: 1px solid #e6e9f0;
    border-radius: 20px;
    background: #ffffff;
  }

  .info-page__faq {
    margin-top: 0.75rem;
    padding: 0 1.25rem;
  }

  .info-page__faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0;
    color: #121a43;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }

  .info-page__faq summary::-webkit-details-marker {
    display: none;
  }

  .info-page__faq summary::after {
    flex-shrink: 0;
    color: #2d42a9;
    font-size: 22px;
    font-weight: 500;
    line-height: 1;
    content: "+";
  }

  .info-page__faq[open] summary::after {
    content: "–";
  }

  .info-page__faq .rte {
    padding: 0 0 1.2rem;
    color: #3a3a3a;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.65;
  }

  .info-page--contact .info-page__panels,
  .info-page--track .info-page__panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .info-page--track .info-page__panels {
    grid-template-columns: 1fr 1fr;
  }

  .info-page--article .info-page__panels {
    overflow: hidden;
    border: 1px solid #e6e9f0;
    border-radius: 22px;
    background: #ffffff;
  }

  .info-page--article .info-page__panel {
    border: 0;
    border-radius: 0;
    border-top: 1px solid #eef0f4;
    background: transparent;
  }

  .info-page--article .info-page__panel:first-child {
    border-top: 0;
  }

  .info-page__panel {
    padding: 1.35rem 1.3rem 1.25rem;
  }

  .info-page__panel p {
    margin: 0 0 0.45rem;
    color: #2d42a9;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .info-page__panel h2 {
    margin: 0 0 0.55rem;
    color: #121a43;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .info-page__panel .rte,
  .info-page .rte {
    color: #3a3a3a;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.65;
  }

  .info-page .rte p {
    margin: 0 0 0.75rem;
    color: #3a3a3a;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .info-page .rte p:last-child {
    margin-bottom: 0;
  }

  .info-page .rte ul {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .info-page .rte li {
    position: relative;
    margin-top: 0.35rem;
    padding-left: 0.95rem;
  }

  .info-page .rte li::before {
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #2d42a9;
    content: "";
  }

  .info-page .rte a {
    color: #2d42a9;
    font-weight: 600;
    text-decoration: none;
  }

  .info-page .rte a:hover {
    text-decoration: underline;
  }

  .info-page__form-card {
    padding: 1.5rem 1.35rem 1.4rem;
  }

  .info-page__form-card h2 {
    margin: 0 0 1.1rem;
    color: #121a43;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .info-page__form {
    display: grid;
    gap: 0.85rem;
  }

  .info-page__form label span {
    display: block;
    margin-bottom: 0.4rem;
    color: #121a43;
    font-size: 13px;
    font-weight: 600;
  }

  .info-page__form input,
  .info-page__form textarea {
    width: 100%;
    border: 1px solid #e1e5ee;
    border-radius: 14px;
    background: #ffffff;
    color: #121a43;
    font: inherit;
    font-size: 15px;
    padding: 0.85rem 0.95rem;
  }

  .info-page__form textarea {
    resize: vertical;
  }

  .info-page__form button {
    justify-self: start;
    min-height: 52px;
    margin-top: 0.35rem;
    padding: 0 1.6rem;
    border: 0;
    border-radius: 14px;
    background: linear-gradient(90deg, #121a43, #2d42a9);
    color: #ffffff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .info-page__success {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    background: #eef1f8;
    color: #121a43;
    font-size: 14px;
    font-weight: 600;
  }

  .info-page__note {
    margin: 1rem 0 0;
    color: #8b93a7;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .info-page--contact .info-page__panels,
    .info-page--track .info-page__panels {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .info-page {
      padding: 3rem 1rem 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.info_page.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.info_page.settings.layout",
      "default": "faq",
      "options": [
        { "value": "faq", "label": "t:sections.info_page.options.faq" },
        { "value": "contact", "label": "t:sections.info_page.options.contact" },
        { "value": "article", "label": "t:sections.info_page.options.article" },
        { "value": "track", "label": "t:sections.info_page.options.track" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.info_page.settings.eyebrow",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.info_page.settings.heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "updated",
      "label": "t:sections.info_page.settings.updated"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.info_page.settings.intro",
      "default": "<p>Answers to the questions we hear most often about Riavâte.</p>"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "t:sections.info_page.settings.form_heading",
      "default": "Contact form"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:sections.info_page.settings.note"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.info_page.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.info_page.blocks.question.question",
          "default": "What is the Riavâte Micro-Infusion System?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.info_page.blocks.question.answer",
          "default": "<p>Riavâte is a precision scalp-care system.</p>"
        }
      ]
    },
    {
      "type": "panel",
      "name": "t:sections.info_page.blocks.panel.name",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.info_page.blocks.panel.kicker"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.info_page.blocks.panel.title",
          "default": "Section"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.info_page.blocks.panel.text",
          "default": "<p>Add the section text.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.info_page.name"
    }
  ]
}
{% endschema %}

        "xyli": {
          "type": "card",
          "settings": {
            "index": "18 \u2014 Xylitylglucoside Complex",
            "title": "Moisture balance",
            "text": "<p>A sugar-derived moisturising complex used to support skin hydration and moisture balance.</p>",
            "why_label": "Why we use it",
            "why": "To help maintain a comfortable, well-hydrated scalp as part of the formula's moisturising system.",
            "image_name": "ingredients-24.jpg"
          }

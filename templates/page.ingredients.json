        "glycerin": {
          "type": "card",
          "settings": {
            "index": "19 \u2014 Glycerin",
            "title": "Essential hydration",
            "text": "<p>A widely used humectant that attracts water and helps maintain skin moisture.</p>",
            "why_label": "Why we use it",
            "why": "To help keep the scalp hydrated and support the formula's overall moisturising performance.",

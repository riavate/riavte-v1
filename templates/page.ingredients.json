        "allantoin": {
          "type": "card",
          "settings": {
            "index": "20 \u2014 Allantoin",
            "title": "Scalp comfort",
            "text": "<p>A skin-conditioning ingredient valued for its soothing properties and ability to support a comfortable-feeling scalp.</p>",
            "why_label": "Why we use it",
            "why": "To help condition the scalp and complement the formula's gentle scalp-care approach.",
            "image_name": "ingredients-26.jpg"
          }
        },
        "glucan": {
          "type": "card",
          "settings": {
            "index": "21 \u2014 Beta-Glucan",
            "title": "Soothing & hydration",
            "text": "<p>A polysaccharide ingredient known for its moisturising and skin-conditioning properties.</p>",
            "why_label": "Why we use it",
            "why": "To provide additional hydration and support a comfortable-feeling scalp.",
            "image_name": "ingredients-27.jpg"
          }
        },
        "theanine": {
          "type": "card",
          "settings": {
            "index": "22 \u2014 Theanine",
            "title": "Amino acid care",
            "text": "<p>An amino acid compound included as part of a considered cosmetic scalp-care formulation.</p>",

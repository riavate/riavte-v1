    "ingredients_selected": {
      "type": "ingredients-cards",
      "blocks": {
        "ghk": {
          "type": "card",
          "settings": {
            "index": "01 — Copper Tripeptide-1",
            "title": "GHK-Cu · The hero peptide",
            "text": "<p>The leading peptide at the heart of Cuprofuse™. Selected to anchor our peptide-led approach to modern scalp care.</p>",
            "why_label": "Why we use it",
            "why": "To provide Cuprofuse™ with its defining copper-peptide component and support the formula's scalp-conditioning strategy.",
            "image_name": "ingredients-01.jpg"
          }
        },
        "niacinamide": {
          "type": "card",
          "settings": {
            "index": "02 — Niacinamide",
            "title": "Scalp barrier support",
            "text": "<p>A versatile form of vitamin B3 widely used in modern cosmetic skincare.</p>",
            "why_label": "Why we use it",
            "why": "To help condition the scalp and support its natural barrier, creating a well-cared-for environment for healthier-looking hair.",
            "image_name": "ingredients-02.jpg"
          }
        },
        "caffeine": {
          "type": "card",
          "settings": {
            "index": "03 — Caffeine",
            "title": "Scalp-care active",
            "text": "<p>One of the more extensively studied cosmetic ingredients in topical hair/scalp formulations, although systematic reviews note limitations in the overall quality of clinical evidence.</p>",
            "why_label": "Why we use it",
            "why": "Selected as a targeted scalp-care active to complement Cuprofuse®'s multi-active approach.",
            "image_name": "ingredients-03.jpg"
          }
        },
        "peptide": {
          "type": "card",
          "settings": {
            "index": "04 — Acetyl Tetrapeptide-3",
            "title": "Targeted peptide",
            "text": "<p>A cosmetic peptide incorporated into modern hair and scalp formulations.</p>",
            "why_label": "Why we use it",
            "why": "To complement GHK-Cu and strengthen the peptide-led identity of the Cuprofuse® formula.",
            "image_name": "ingredients-10.jpg"
          }
        },
        "adenosine": {
          "type": "card",
          "settings": {
            "index": "05 — Adenosine",
            "title": "Hair-care active",
            "text": "<p>Adenosine has been investigated in topical hair research, including randomized studies and more recent systematic review evidence.</p>",
            "why_label": "Why we use it",
            "why": "Included as a research-backed component within our broader cosmetic scalp-care formula for appearance of density and condition",
            "image": "shopify://shop_images/7cf36e5333f63846bd0c5b8dc638ae90f8d435f9_1.png",
            "image_name": "ingredients-04.png"
          }
        },
        "biotin": {
          "type": "card",
          "settings": {
            "index": "06 — Biotin",
            "title": "Soothing botanical",
            "text": "<p>Glycyrrhiza glabra is widely used in cosmetics and has published research across topical skincare applications. <a href=\"https://pubmed.ncbi.nlm.nih.gov/32726104/\" target=\"_blank\">PubMed</a></p>",
            "why_label": "Why we use it",
            "why": "To complement the formula with a botanical ingredient selected for scalp-conditioning and soothing-oriented cosmetic care.",
            "image_name": "ingredients-11.jpg"
          }
        },
        "card_cnfG8m": {
          "type": "card",
          "settings": {
            "index": "07 — PANAX GINSENG ROOT EXTRACT",
            "title": "BOTANICAL SCALP CARE",
            "text": "<p>A botanical extract derived from ginseng root, traditionally valued in personal-care formulations.</p>",
            "why_label": "Why we use it",
            "why": "To bring a carefully selected botanical conditioning ingredient into our science-led scalp-care formula.",
            "image": "shopify://shop_images/f656cdcefdb5f7db346456ec3c422535810eb381.jpg",
            "image_name": "ingredients-01.jpg"
          }
        },
        "card_hVfwtz": {
          "type": "card",
          "settings": {
            "index": "08 — POLYGONUM MULTIFLORUM ROOT EXTRACT",
            "title": "TRADITIONAL BOTANICAL CARE",
            "text": "<p>Also known as He Shou Wu, this botanical root extract has a long history of traditional hair-care use.</p>",
            "why_label": "Why we use it",
            "why": "To complement our modern formulation with a root-derived botanical ingredient associated with traditional hair-care practices.",
            "image": "shopify://shop_images/12537b6ffd158a6521a55cb44ade5f3245a65ed2.jpg",
            "image_name": "ingredients-01.jpg"
          }
        },
        "eclipta": {
          "type": "card",
          "settings": {
            "index": "09 — ECLIPTA PROSTRATA EXTRACT",
            "title": "BOTANICAL HAIR-CARE HERITAGE",
            "text": "<p>Also known as Bhringraj, this plant extract has traditionally been associated with hair-care routines.</p>",
            "why_label": "Why we use it",
            "why": "To introduce a botanical scalp-conditioning ingredient into our carefully balanced multi-active formula.",
            "image": "shopify://shop_images/504a39e5b43ee9c7e172abc854484ae3a5bbc02d.png",
            "image_name": "ingredients-07.jpg"
          }
        },
        "card_ahfgq9": {
          "type": "card",
          "settings": {
            "index": "10 — CAMELLIA SINENSIS (GREEN TEA) LEAF EXTRACT",
            "title": "BOTANICAL ANTIOXIDANT CARE",
            "text": "<p>A green tea leaf extract containing naturally occurring polyphenols and valued for its cosmetic antioxidant properties.</p>",
            "why_label": "Why we use it",
            "why": "To complement Cuprofuse™ with a botanical ingredient selected for antioxidant and skin-conditioning support.",
            "image": "shopify://shop_images/4f504ded5abda968bbdd2e6748908d2b0289abe6.jpg",
            "image_name": "ingredients-01.jpg"
          }
        },
        "card_jnE3TT": {
          "type": "card",
          "settings": {
            "index": "11 — GLYCYRRHIZA GLABRA (LICORICE) ROOT EXTRACT",
            "title": "BOTANICAL COMFORT",
            "text": "<p>A licorice-root-derived botanical extract widely used in cosmetic skincare formulations.</p>",
            "why_label": "Why we use it",
            "why": "To support the serum's gentle scalp-conditioning approach with a carefully selected botanical ingredient.",
            "image": "shopify://shop_images/e4b2aaeff4429b42615fb37b6dd563e8cb0f8a77.png",
            "image_name": "ingredients-01.jpg"
          }
        },
        "arginine": {
          "type": "card",
          "settings": {
            "index": "12 — Arginine",
            "title": "Amino acid",
            "text": "<p>An amino acid used in cosmetic skin and hair formulations.</p>",
            "why_label": "Why we use it",
            "why": "Included as a supporting conditioning component within Cuprofuse®'s balanced formula.",
            "image": "shopify://shop_images/f47753ccef58073c16ca508e05beeb3cc8c5c86f_1.png",
            "image_name": "ingredients-13.png"
          }
        },
        "theanine": {
          "type": "card",
          "settings": {
            "index": "13 — Theanine",
            "title": "Amino acid care",
            "text": "<p>An amino acid compound included as part of a considered cosmetic scalp-care formulation.</p>",
            "why_label": "Why we use it",
            "why": "To complement the formula's selected conditioning ingredients and amino acid components.",
            "image": "shopify://shop_images/5bdb1f93870e24557ef42cb8e741c6be6cd9d55b_1.jpg",
            "image_name": "ingredients-28.jpg"
          }
        },
        "panthenol": {
          "type": "card",
          "settings": {
            "index": "14 — Panthenol",
            "title": "Condition + hydration",
            "text": "<p>Pro-vitamin B5 is widely used as a hair- and skin-conditioning ingredient and humectant.</p>",
            "why_label": "Why we use it",
            "why": "To help moisturise and condition the scalp and hair while supporting a comfortable application experience.",
            "image": "shopify://shop_images/514a13087cbfccf7615811b795bdced3287fc08d_1.jpg",
            "image_name": "ingredients-05.jpg"
          }
        },
        "hyaluronic": {
          "type": "card",
          "settings": {
            "index": "15 — SODIUM HYALURONATE",
            "title": "Advanced hydration",
            "text": "<p>A form of hyaluronic acid valued for its moisture-binding and skin-hydrating properties.</p>",
            "why_label": "Why we use it",
            "why": "To help retain moisture and support a hydrated, well-conditioned scalp.",
            "image": "shopify://shop_images/32a776279a3358de0c3b31fc95c2329a07b6f95e_1.jpg",
            "image_name": "ingredients-21.jpg"
          }
        },
        "glycerin": {
          "type": "card",
          "settings": {
            "index": "16 — Glycerin",
            "title": "Essential hydration",
            "text": "<p>A widely used humectant that attracts water and helps maintain skin moisture.</p>",
            "why_label": "Why we use it",
            "why": "To help keep the scalp hydrated and support the formula's overall moisturising performance.",
            "image": "shopify://shop_images/fccd16c84c23e39993a7bfb831982f9d177587ae_1.jpg",
            "image_name": "ingredients-25.jpg"
          }
        },
        "trehalose": {
          "type": "card",
          "settings": {
            "index": "17 — Trehalose",
            "title": "Moisture protection",
            "text": "<p>A sugar-derived humectant that helps retain moisture and support scalp hydration.</p>",
            "why_label": "Why we use it",
            "why": "To help protect against moisture loss and maintain a hydrated scalp environment.",
            "image": "shopify://shop_images/d98c6c477e3edfdbe93fc6d3056e47d2df80052f_1.jpg",
            "image_name": "ingredients-22.jpg"
          }
        },
        "collagen": {
          "type": "card",
          "settings": {
            "index": "18 — Soluble Collagen",
            "title": "Conditioning & softness",
            "text": "<p>A cosmetic conditioning ingredient that helps improve the feel and softness of skin and hair.</p>",
            "why_label": "Why we use it",
            "why": "To complement the formula with additional conditioning and moisture-supporting properties.",
            "image_name": "ingredients-23.jpg"
          }
        },
        "card_6LmzX8": {
          "type": "card",
          "settings": {
            "index": "19 — ANHYDROXYLITOL",
            "title": "HYDRATION COMPLEX",
            "text": "<p>A sugar-derived humectant commonly used alongside complementary moisturising ingredients.</p>",
            "why_label": "Why we use it",
            "why": "To help support moisture balance as part of Cuprofuse™'s combined hydration system.",
            "image": "shopify://shop_images/d278e4e557422e8859598fa19eb856d8a128bab2.jpg",
            "image_name": "ingredients-01.jpg"
          }
        },
        "xyli": {
          "type": "card",
          "settings": {
            "index": "20 —XYLITYLGLUCOSIDE",
            "title": "MOISTURE-BINDING SUPPORT",
            "text": "<p>A sugar-derived ingredient used in cosmetic moisturising systems.</p>",
            "why_label": "Why we use it",
            "why": "To contribute to the formula's hydration-focused approach and support moisture retention.",
            "image": "shopify://shop_images/7d436db9d824015f06118f404ea695a3ac52bc68_1.jpg",
            "image_name": "ingredients-24.jpg"
          }
        },
        "ginseng": {
          "type": "card",
          "settings": {
            "index": "06 — Panax Ginseng Root Extract",
            "title": "Botanical support",
            "text": "<p>A botanical extract with a long history of cosmetic use.</p>",
            "why_label": "Why we use it",
            "why": "Selected as part of Cuprofuse®'s botanical complex to complement the formula's scalp-conditioning approach.",
            "image_name": "ingredients-06.jpg"
          }
        },
        "licorice": {
          "type": "card",
          "settings": {
            "index": "08 — Licorice Root Extract",
            "title": "Soothing botanical",
            "text": "<p>Glycyrrhiza glabra is widely used in cosmetics and has published research across topical skincare applications. <a href=\"https://pubmed.ncbi.nlm.nih.gov/32726104/\" target=\"_blank\" rel=\"noopener\">PubMed</a></p>",
            "why_label": "Why we use it",
            "why": "To complement the formula with a botanical ingredient selected for scalp-conditioning and soothing-oriented cosmetic care.",
            "image_name": "ingredients-08.jpg"
          }
        },
        "tea": {
          "type": "card",
          "settings": {
            "index": "09 — Camellia Sinensis Leaf Extract",
            "title": "Green tea extract",
            "text": "<p>A botanical widely used in cosmetic formulations.</p>",
            "why_label": "Why we use it",
            "why": "Selected to contribute antioxidant-oriented botanical support to the overall scalp-care formula.",
            "image_name": "ingredients-09.jpg"
          }
        },
        "salicylic": {
          "type": "card",
          "settings": {
            "index": "12 — Salicylic Acid",
            "title": "Scalp clarity",
            "text": "<p>A well-established cosmetic ingredient used for skin/scalp conditioning and exfoliation-related functions depending on formulation and concentration. Cosmetic safety depends on compliant concentration and formulation. <a href=\"https://pubmed.ncbi.nlm.nih.gov/41243163/\" target=\"_blank\" rel=\"noopener\">PubMed</a></p>",
            "why_label": "Why we use it",
            "why": "To support a cleaner, refined scalp environment as part of the complete formula.",
            "image_name": "ingredients-12.png"
          }
        },
        "heshouwu": {
          "type": "card",
          "settings": {
            "index": "14 — He Shou Wu",
            "title": "Traditional botanical",
            "text": "<p>A botanical extract used in cosmetic skin and hair formulations.</p>",
            "why_label": "Why we use it",
            "why": "To bring a heritage-inspired botanical element into our modern scalp-care formula.",
            "image_name": "ingredients-20.jpg"
          }
        },
        "allantoin": {
          "type": "card",
          "settings": {
            "index": "20 — Allantoin",
            "title": "Scalp comfort",
            "text": "<p>A skin-conditioning ingredient valued for its soothing properties and ability to support a comfortable-feeling scalp.</p>",
            "why_label": "Why we use it",
            "why": "To help condition the scalp and complement the formula's gentle scalp-care approach.",
            "image_name": "ingredients-26.jpg"
          }
        },
        "glucan": {
          "type": "card",
          "settings": {
            "index": "21 — Beta-Glucan",
            "title": "Soothing & hydration",
            "text": "<p>A polysaccharide ingredient known for its moisturising and skin-conditioning properties.</p>",
            "why_label": "Why we use it",
            "why": "To provide additional hydration and support a comfortable-feeling scalp.",
            "image_name": "ingredients-27.jpg"
          }
        }
      },

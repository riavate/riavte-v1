{% doc %}
  Renders the Riavâte mark as the browser favicon and Apple touch icon.

  @example
  {% render 'favicon' %}
{% enddoc %}

<link rel="icon" href="{{ 'favicon.ico' | asset_url }}" sizes="48x48">
<link rel="icon" type="image/png" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32">
<link rel="icon" type="image/png" href="{{ 'favicon-192.png' | asset_url }}" sizes="192x192">
<link rel="icon" type="image/png" href="{{ 'favicon-512.png' | asset_url }}" sizes="512x512">
<link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
